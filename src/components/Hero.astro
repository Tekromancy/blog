---
import ScrollReveal from "./ScrollReveal.tsx";
import { Icon } from "astro-icon/components";
import sketchSvg from "../assets/sketch.svg";
---

<section 
  class="hero-section py-24 md:py-36 relative overflow-hidden" 
  aria-labelledby="hero-heading"
  style={`background-color: var(--token-color-background, #000000); --sketch-svg: url('${sketchSvg.src}')`}
>
  <div class="max-w-5xl mx-auto px-4 text-center">
    <!-- Interactive terminal badge -->
    <ScrollReveal client:load>
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border mb-8 text-xs font-mono shadow-xs backdrop-blur-sm"
        style="background-color: var(--token-color-surface, #1e293b); border-color: var(--token-color-border, #334155); color: var(--token-color-primary, #22EE44);"
      >
        <span class="inline-block w-2 h-2 rounded-full animate-pulse" style="background-color: var(--token-color-primary, #22EE44);"></span>
        <span class="opacity-75">tekromancy@node-01:~$</span>
        <span style="color: var(--token-color-primary, #22EE44);">uname -r -m</span>
        <span class="opacity-60">// 6.12.x-zen x86_64</span>
      </div>
    </ScrollReveal>

    <ScrollReveal client:load delay={0.1}>
      <h1 id="hero-heading" class="text-5xl md:text-7xl font-extrabold tracking-tight font-mono mb-6" style="color: var(--token-color-text-primary, #111827);">
        Tekromancy
      </h1>
    </ScrollReveal>

    <ScrollReveal client:load delay={0.2}>
      <p class="text-xl md:text-2xl mb-8 max-w-3xl mx-auto leading-relaxed" style="color: var(--token-color-text-muted, #374151);">
        Technomancy, systems architecture, and low-level sorcery. Deep dives into <span class="font-semibold" style="color: var(--token-color-text-primary, #111827);">Linux internals</span>, <span class="font-semibold" style="color: var(--token-color-text-primary, #111827);">Kubernetes orchestration</span>, <span class="font-semibold" style="color: var(--token-color-text-primary, #111827);">AI/ML infrastructure</span>, <span class="font-semibold" style="color: var(--token-color-text-primary, #111827);">networking</span>, and <span class="font-semibold" style="color: var(--token-color-text-primary, #111827);">cybersecurity</span>.
      </p>
    </ScrollReveal>

    <!-- Tech focus pills -->
    <ScrollReveal client:load delay={0.3}>
      <div class="flex flex-wrap items-center justify-center gap-2 mb-10 text-xs font-mono">
        <a href="/blog?tag=linux" class="px-3 py-1 rounded-md border transition-colors hover:border-[var(--token-color-primary)]" style="background-color: var(--token-color-surface, #f8fafc); border-color: var(--token-color-border, #e2e8f0); color: var(--token-color-text-primary, #111827);">
          🐧 Linux &amp; Kernel
        </a>
        <a href="/blog?tag=kubernetes" class="px-3 py-1 rounded-md border transition-colors hover:border-[var(--token-color-primary)]" style="background-color: var(--token-color-surface, #f8fafc); border-color: var(--token-color-border, #e2e8f0); color: var(--token-color-text-primary, #111827);">
          ☸️ Kubernetes
        </a>
        <a href="/blog?tag=ai-ml" class="px-3 py-1 rounded-md border transition-colors hover:border-[var(--token-color-primary)]" style="background-color: var(--token-color-surface, #f8fafc); border-color: var(--token-color-border, #e2e8f0); color: var(--token-color-text-primary, #111827);">
          🤖 AI / ML Systems
        </a>
        <a href="/blog?tag=networking" class="px-3 py-1 rounded-md border transition-colors hover:border-[var(--token-color-primary)]" style="background-color: var(--token-color-surface, #f8fafc); border-color: var(--token-color-border, #e2e8f0); color: var(--token-color-text-primary, #111827);">
          🌐 Networking &amp; BGP
        </a>
        <a href="/blog?tag=security" class="px-3 py-1 rounded-md border transition-colors hover:border-[var(--token-color-primary)]" style="background-color: var(--token-color-surface, #f8fafc); border-color: var(--token-color-border, #e2e8f0); color: var(--token-color-text-primary, #111827);">
          🛡️ Cybersecurity
        </a>
      </div>
    </ScrollReveal>

    <ScrollReveal client:load delay={0.4}>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/blog"
          class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-lg transition-opacity font-medium shadow-md"
          style="background-color: var(--token-color-primary, #0ea5e9); color: var(--token-color-primary-foreground, #ffffff);"
          onmouseenter={(e) => e.currentTarget.style.opacity = '0.9'}
          onmouseleave={(e) => e.currentTarget.style.opacity = '1'}
          aria-label="Read technical articles"
        >
          <Icon name="tabler:terminal" class="w-5 h-5" aria-hidden="true" />
          <span>Read Articles</span>
        </a>
        <a
          href="#domains"
          class="inline-flex items-center justify-center gap-2 px-8 py-3.5 border rounded-lg transition-colors font-medium"
          style="background-color: var(--token-color-background, #ffffff); color: var(--token-color-text-primary, #111827); border-color: var(--token-color-border, #e5e7eb);"
          onmouseenter={(e) => e.currentTarget.style.backgroundColor = 'var(--token-color-accent, rgba(0, 0, 0, 0.05))'}
          onmouseleave={(e) => e.currentTarget.style.backgroundColor = 'var(--token-color-background, #ffffff)'}
          aria-label="Explore technical domains"
        >
          <Icon name="tabler:cpu" class="w-5 h-5" aria-hidden="true" />
          <span>Explore Domains</span>
        </a>
      </div>
    </ScrollReveal>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
  }

  .hero-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    background-image: var(--sketch-svg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.45;
  }

  /* Ensure Hero content is above the background */
  .hero-section > div {
    position: relative;
    z-index: 1;
  }
</style>
