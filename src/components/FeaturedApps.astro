---
import { TEKROMANCY_APPS } from "../data/apps";
import { Icon } from "astro-icon/components";
import ScrollReveal from "./ScrollReveal.tsx";

const apps = TEKROMANCY_APPS;

const appIcons: Record<string, string> = {
  sparetank: "tabler:battery-charging-2",
  "silent-mode-control": "tabler:phone-off",
  coordy: "tabler:compass",
  glyphrig: "tabler:bookmarks",
};
---

<section class="max-w-6xl mx-auto px-4 py-20 border-t" style="border-color: var(--token-color-border, #1a291f);">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
    <div>
      <h2
        class="text-3xl md:text-4xl font-bold font-mono tracking-tight mb-2"
        style="color: var(--token-color-text-primary, #111827);"
      >
        Featured Applications
      </h2>
      <p class="text-sm md:text-base tk-copy-secondary max-w-xl">
        Sovereign client tools and Tekromancy-sponsored open-source projects built for local-first execution and zero surveillance telemetry.
      </p>
    </div>
    <a
      href="/apps"
      class="tk-focus-ring inline-flex items-center gap-1.5 font-mono text-sm font-semibold transition-colors hover:underline"
      style="color: var(--token-color-primary, #22c55e);"
    >
      <span>Explore all sovereign tools</span>
      <Icon name="tabler:arrow-right" class="w-4 h-4" aria-hidden="true" />
    </a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    {apps.map((app, index) => {
      const iconName = appIcons[app.id] || "tabler:apps";
      return (
        <ScrollReveal client:load delay={0.12 * index}>
          <article
            class="tk-card relative rounded-2xl p-6 sm:p-8 flex flex-col justify-between h-full overflow-hidden group"
          >
            <!-- Subtle Per-App Accent Wash -->
            <div
              class="absolute -top-24 -right-24 w-72 h-72 opacity-10 pointer-events-none rounded-full blur-3xl transition-opacity duration-300 group-hover:opacity-20"
              style={`background: radial-gradient(circle, ${app.accentFrom}, ${app.accentTo});`}
              aria-hidden="true"
            ></div>

            <div class="relative z-10">
              <!-- Top Status Row -->
              <div class="flex flex-wrap items-center justify-between gap-2 mb-5">
                <span
                  class="px-2.5 py-0.5 rounded text-[11px] font-mono font-semibold tracking-wider uppercase border"
                  style={`background-color: var(--token-color-background, #000000); border-color: ${app.accentFrom}55; color: ${app.accentFrom};`}
                >
                  {app.category}
                </span>
                <div class="flex flex-wrap items-center gap-1.5">
                  {app.sponsored && (
                    <span
                      class="text-[10px] font-mono font-bold px-2 py-0.5 rounded border"
                      style="background-color: var(--token-color-background, #000000); border-color: var(--token-color-primary, #22c55e); color: var(--token-color-primary, #22c55e);"
                    >
                      SPONSORED
                    </span>
                  )}
                  <span class="relative flex h-2 w-2" aria-hidden="true">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75" style={`background-color: ${app.accentFrom};`}></span>
                    <span class="relative inline-flex rounded-full h-2 w-2" style={`background-color: ${app.accentFrom};`}></span>
                  </span>
                  <span
                    class="text-[10px] font-mono font-bold px-2 py-0.5 rounded border tk-copy-meta"
                    style="background-color: var(--token-color-background, #000000); border-color: var(--token-color-border, #1a291f);"
                  >
                    {app.statusLabel}
                  </span>
                </div>
              </div>

              <!-- Title & Vector Icon -->
              <div class="flex items-center gap-4 mb-4">
                <div
                  class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl flex items-center justify-center border shrink-0"
                  style={`background: linear-gradient(135deg, ${app.accentFrom}20, ${app.accentTo}12); border-color: ${app.accentFrom}55; color: ${app.accentFrom};`}
                >
                  <Icon name={iconName} class="w-6 h-6 sm:w-7 sm:h-7" aria-hidden="true" />
                </div>
                <div>
                  <h3
                    class="text-xl sm:text-2xl font-extrabold font-mono tracking-tight"
                    style="color: var(--token-color-text-primary, #111827);"
                  >
                    {app.name}
                  </h3>
                  <p class="text-xs font-mono mt-0.5 font-semibold" style={`color: ${app.accentFrom};`}>
                    {app.tagline}
                  </p>
                </div>
              </div>

              <p class="text-sm leading-relaxed tk-copy-secondary mb-6">
                {app.description}
              </p>

              <!-- Highlights -->
              <ul class="space-y-2 mb-6 text-xs font-mono tk-copy-secondary">
                {app.highlights.slice(0, 3).map((highlight) => (
                  <li class="flex items-start gap-2">
                    <Icon name="tabler:check" class="w-4 h-4 shrink-0 mt-0.5" style={`color: ${app.accentFrom};`} aria-hidden="true" />
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Action Bar -->
            <div
              class="relative z-10 pt-4 border-t flex flex-wrap items-center justify-between gap-3"
              style="border-color: var(--token-color-border, #1a291f);"
            >
              <a
                href={app.url}
                target="_blank"
                rel="noopener noreferrer"
                class="tk-focus-ring inline-flex items-center gap-2 px-4 py-2 rounded-lg font-mono font-bold text-xs text-black transition-transform duration-200 hover:-translate-y-0.5"
                style={`background: linear-gradient(135deg, ${app.accentFrom}, ${app.accentTo}); box-shadow: 0 6px 16px -4px ${app.accentFrom}66;`}
              >
                <span>Launch {app.shortName} Portal</span>
                <Icon name="tabler:arrow-up-right" class="w-3.5 h-3.5" aria-hidden="true" />
              </a>

              <a
                href={`/apps#${app.id}`}
                class="tk-focus-ring inline-flex items-center gap-1 text-xs font-mono font-medium tk-copy-meta hover:text-[var(--token-color-primary)] transition-colors"
              >
                <span>View specs</span>
                <Icon name="tabler:chevron-right" class="w-3.5 h-3.5" aria-hidden="true" />
              </a>
            </div>
          </article>
        </ScrollReveal>
      );
    })}
  </div>
</section>
