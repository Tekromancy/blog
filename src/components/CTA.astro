---
import ScrollReveal from "./ScrollReveal.tsx";
import { Icon } from "astro-icon/components";
---

<section id="cta" class="max-w-5xl mx-auto px-4 py-16">
  <ScrollReveal client:idle scale={true}>
    <div class="tk-plate p-8 sm:p-12 md:p-14 text-center relative overflow-hidden">
      <h2 class="text-3xl md:text-5xl font-extrabold font-mono tracking-tight mb-4 text-balance" style="color: var(--token-color-text-primary, #111827);">
        Master the Art of Infrastructure
      </h2>
      <p class="text-base sm:text-lg md:text-xl mb-8 max-w-2xl mx-auto leading-relaxed tk-copy-secondary">
        From low-level kernel tracing to multi-cluster Kubernetes deployments and local AI pipelines, learn how to build resilient, sovereign tech stacks.
      </p>
      <div class="flex flex-col sm:flex-row gap-3.5 justify-center">
        <a href="/blog" class="tk-btn-primary">
          <Icon name="tabler:terminal" class="w-4 h-4" aria-hidden="true" />
          <span>Browse All Articles</span>
        </a>
        <a href="/about" class="tk-btn-secondary">
          <Icon name="tabler:info-circle" class="w-4 h-4" aria-hidden="true" />
          <span>About Tekromancy</span>
        </a>
      </div>
    </div>
  </ScrollReveal>
</section>
