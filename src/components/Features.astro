---
import ScrollReveal from "./ScrollReveal.tsx";
import { Icon } from "astro-icon/components";

const domains = [
  {
    title: "Linux & Kernel Internals",
    icon: "tabler:terminal-2",
    tag: "linux",
    description: "eBPF tracing, system calls, custom kernels, systemd tuning, memory management, and low-level performance profiling.",
  },
  {
    title: "Kubernetes & Cloud Native",
    icon: "tabler:topology-star-3",
    tag: "kubernetes",
    description: "Production cluster hardening, Cilium eBPF CNI, GitOps with ArgoCD, custom CRDs, and scalable cloud-native workloads.",
  },
  {
    title: "AI / ML Systems Engineering",
    icon: "tabler:brain",
    tag: "ai-ml",
    description: "High-throughput inference with vLLM & Ollama, model quantization, CUDA acceleration, and local model orchestration.",
  },
  {
    title: "Distributed Networking",
    icon: "tabler:network",
    tag: "networking",
    description: "WireGuard overlay mesh networks, dynamic BGP routing, software-defined networking, and deep packet inspection.",
  },
  {
    title: "Cybersecurity & SecOps",
    icon: "tabler:shield-lock",
    tag: "security",
    description: "Zero-trust architecture, Linux server hardening, defense-in-depth, threat modeling, and container security compliance.",
  },
  {
    title: "Infrastructure & Homelabs",
    icon: "tabler:server-2",
    tag: "devops",
    description: "Reproducible builds with NixOS, Terraform, declarative automation, bare-metal clusters, and self-hosted wizardry.",
  },
];
---

<section id="domains" class="max-w-6xl mx-auto px-4 py-20">
  <ScrollReveal client:idle delay={0.1}>
    <div class="text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-bold font-mono tracking-tight mb-3" style="color: var(--token-color-text-primary, #111827);">
        Technical Domains
      </h2>
      <p class="text-base md:text-lg max-w-xl mx-auto" style="color: var(--token-color-text-muted, #64748b);">
        Deep exploration of modern computing infrastructure from the kernel to distributed intelligence.
      </p>
    </div>
  </ScrollReveal>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch">
    {domains.map((domain, index) => (
      <ScrollReveal client:idle delay={0.15 * (index % 3)} scale={true}>
        <a
          href={`/blog?tag=${domain.tag}`}
          class="group block p-6 rounded-xl border transition-all h-full flex flex-col relative overflow-hidden"
          style="background-color: var(--token-color-background, #ffffff); border-color: var(--token-color-border, #e5e7eb);"
          onmouseenter={(e) => {
            e.currentTarget.style.backgroundColor = 'var(--token-color-hover, rgba(14, 165, 233, 0.05))';
            e.currentTarget.style.borderColor = 'var(--token-color-primary, #0ea5e9)';
            e.currentTarget.style.boxShadow = 'var(--token-shadow-2)';
          }}
          onmouseleave={(e) => {
            e.currentTarget.style.backgroundColor = 'var(--token-color-background, #ffffff)';
            e.currentTarget.style.borderColor = 'var(--token-color-border, #e5e7eb)';
            e.currentTarget.style.boxShadow = 'none';
          }}
        >
          <div
            class="w-12 h-12 rounded-lg flex items-center justify-center mb-4 transition-transform duration-200 group-hover:scale-110"
            style="background-color: var(--token-color-surface, #f1f5f9); color: var(--token-color-primary, #0ea5e9);"
          >
            <Icon name={domain.icon} class="w-6 h-6" aria-hidden="true" />
          </div>
          <h3 class="text-xl font-bold mb-2 font-mono flex items-center justify-between" style="color: var(--token-color-text-primary, #111827);">
            <span>{domain.title}</span>
            <span class="text-xs opacity-0 group-hover:opacity-100 transition-opacity font-mono" style="color: var(--token-color-primary, #0ea5e9);">→</span>
          </h3>
          <p class="text-sm leading-relaxed flex-1" style="color: var(--token-color-text-muted, #64748b);">
            {domain.description}
          </p>
          <div class="mt-4 pt-3 border-t flex items-center justify-between text-xs font-mono" style="border-color: var(--token-color-border, #e5e7eb); color: var(--token-color-text-muted, #64748b);">
            <span>#{domain.tag}</span>
            <span class="group-hover:text-[var(--token-color-primary)] transition-colors">Explore articles</span>
          </div>
        </a>
      </ScrollReveal>
    ))}
  </div>
</section>
