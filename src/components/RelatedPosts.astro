---
import type { CollectionEntry } from "astro:content";

interface Props {
	currentPost: CollectionEntry<"blog">;
	allPosts: CollectionEntry<"blog">[];
}

const { currentPost, allPosts } = Astro.props;

// Filter out current post and drafts
const otherPosts = allPosts.filter(
	(p) => p.id !== currentPost.id && !p.data.draft
);

// Score posts by number of matching tags
const currentTags = new Set(currentPost.data.tags || []);

const scoredPosts = otherPosts.map((p) => {
	const matchCount = (p.data.tags || []).filter((tag) =>
		currentTags.has(tag)
	).length;
	return { post: p, matchCount };
});

// Sort by match count descending, then by pubDate descending
scoredPosts.sort((a, b) => {
	if (b.matchCount !== a.matchCount) {
		return b.matchCount - a.matchCount;
	}
	return b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf();
});

const relatedPosts = scoredPosts.slice(0, 3).map((item) => item.post);
---

{
	relatedPosts.length > 0 && (
		<section class="related-dispatches my-12 pt-8 border-t border-[var(--token-color-border,#334155)]">
			<div class="flex items-center gap-2 mb-6">
				<span class="inline-block w-2 h-2 rounded-full bg-[#38bdf8] animate-pulse" />
				<h2 class="text-lg md:text-xl font-bold font-mono tracking-tight text-white">
					Related Field Dispatches
				</h2>
			</div>

			<div class="grid sm:grid-cols-2 gap-4">
				{relatedPosts.map((post) => (
					<a
						href={`/blog/${post.id}`}
						class="group block p-5 rounded-xl border border-[var(--token-color-border,#1e293b)] bg-[#0a100d]/60 hover:bg-[#0f1713] hover:border-[#22c55e]/50 transition-all duration-200"
					>
						<div class="flex items-center gap-2 mb-2">
							<span class="text-[11px] font-mono font-semibold px-2 py-0.5 rounded bg-[#22c55e]/10 text-[#22c55e] border border-[#22c55e]/30">
								{post.data.tags && post.data.tags[0]
									? `#${post.data.tags[0]}`
									: "DISPATCH"}
							</span>
							<time
								datetime={post.data.pubDate.toISOString()}
								class="text-xs font-mono text-gray-400"
							>
								{post.data.pubDate.toLocaleDateString("en-US", {
									month: "short",
									day: "numeric",
									year: "numeric",
								})}
							</time>
						</div>
						<h3 class="text-sm sm:text-base font-bold font-mono text-gray-100 group-hover:text-[#22c55e] transition-colors line-clamp-2 mb-2">
							{post.data.title}
						</h3>
						<p class="text-xs text-gray-400 line-clamp-2 leading-relaxed">
							{post.data.description}
						</p>
						<div class="mt-4 flex items-center text-xs font-mono text-[#38bdf8] group-hover:translate-x-1 transition-transform">
							<span>Read intel &rarr;</span>
						</div>
					</a>
				))}
			</div>
		</section>
	)
}
