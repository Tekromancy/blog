---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";

interface Props {
	currentPost: CollectionEntry<"blog">;
	allPosts: CollectionEntry<"blog">[];
}

const { currentPost, allPosts } = Astro.props;

const otherPosts = allPosts.filter(
	(p) => p.id !== currentPost.id && !p.data.draft
);

const currentTags = new Set(currentPost.data.tags || []);

const scoredPosts = otherPosts.map((p) => {
	const matchCount = (p.data.tags || []).filter((tag) =>
		currentTags.has(tag)
	).length;
	return { post: p, matchCount };
});

scoredPosts.sort((a, b) => {
	if (b.matchCount !== a.matchCount) {
		return b.matchCount - a.matchCount;
	}
	return b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf();
});

const relatedPosts = scoredPosts.slice(0, 3).map((item) => item.post);
---

{
	relatedPosts.length > 0 && (
		<section
			class="related-dispatches my-12 pt-8 border-t"
			style="border-color: var(--token-color-border, #1a291f);"
		>
			<div class="flex items-center gap-2.5 mb-6">
				<span
					class="inline-block w-2 h-2 rounded-full"
					style="background-color: var(--token-color-primary, #22c55e);"
					aria-hidden="true"
				/>
				<h2
					class="text-lg md:text-xl font-bold font-mono tracking-tight"
					style="color: var(--token-color-text-primary, #111827);"
				>
					Related Field Dispatches
				</h2>
			</div>

			<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
				{relatedPosts.map((post) => (
					<a
						href={`/blog/${post.id}`}
						class="tk-card group flex flex-col justify-between p-5 no-underline"
					>
						<div>
							<div class="flex items-center justify-between gap-2 mb-2.5">
								<span
									class="text-[11px] font-mono font-semibold px-2 py-0.5 rounded border"
									style="background-color: var(--token-color-background, #000000); border-color: var(--token-color-border, #1a291f); color: var(--token-color-primary, #22c55e);"
								>
									{post.data.tags && post.data.tags[0]
										? `#${post.data.tags[0]}`
										: "DISPATCH"}
								</span>
								<time
									datetime={post.data.pubDate.toISOString()}
									class="text-xs font-mono tk-copy-meta"
								>
									{post.data.pubDate.toLocaleDateString("en-US", {
										month: "short",
										day: "numeric",
										year: "numeric",
									})}
								</time>
							</div>
							<h3
								class="text-sm sm:text-base font-bold font-mono group-hover:text-[var(--token-color-primary)] transition-colors line-clamp-2 mb-2"
								style="color: var(--token-color-text-primary, #111827);"
							>
								{post.data.title}
							</h3>
							<p class="text-xs line-clamp-2 leading-relaxed tk-copy-secondary">
								{post.data.description}
							</p>
						</div>
						<div
							class="mt-4 inline-flex items-center gap-1 text-xs font-mono font-semibold group-hover:translate-x-1 transition-transform"
							style="color: var(--token-color-primary, #22c55e);"
						>
							<span>Read dispatch</span>
							<Icon name="tabler:arrow-right" class="w-3.5 h-3.5" aria-hidden="true" />
						</div>
					</a>
				))}
			</div>
		</section>
	)
}
