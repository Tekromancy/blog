---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import { SITE } from "../config/site.mjs";
import { Icon } from "astro-icon/components";
import { getAllAuthors } from "../data/authors";

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
        { "@type": "ListItem", "position": 2, "name": "About", "item": `${SITE.url}/about` }
      ]
    },
    {
      "@type": "AboutPage",
      "name": `About | ${SITE.title}`,
      "description": "About Tekromancy: Explorations into the arcane arts of Linux, Kubernetes, AI/ML systems, distributed networking, and cybersecurity.",
      "url": `${SITE.url}/about`,
      "publisher": {
        "@type": "Organization",
        "name": SITE.title,
        "logo": {
          "@type": "ImageObject",
          "url": `${SITE.url}/favicon.svg`
        }
      }
    }
  ]
};
---

<Layout
  title={`About | ${SITE.title}`}
  description="About Tekromancy: Explorations into the arcane arts of Linux, Kubernetes, AI/ML systems, distributed networking, and cybersecurity."
  canonicalURL={`${SITE.url}/about`}
  jsonLd={aboutJsonLd}
>
  <Header />
  <main id="main-content" role="main" style="background-color: var(--token-color-background, #000000);">
    <section class="max-w-4xl mx-auto px-4 py-16 md:py-20">
      <ScrollReveal client:idle>
        <h1 class="text-4xl md:text-6xl font-extrabold font-mono tracking-tight mb-4 text-balance" style="color: var(--token-color-text-primary, #111827);">
          About Tekromancy
        </h1>
      </ScrollReveal>
      <ScrollReveal client:load delay={0.1}>
        <p class="text-xl md:text-2xl mb-12 leading-relaxed tk-copy-secondary">
          Demystifying the arcane arts of modern computing—from Linux kernel internals and distributed Kubernetes clusters to local neural intelligence and hardened cryptographic networks.
        </p>
      </ScrollReveal>

      <div class="prose prose-lg max-w-none">
        <ScrollReveal client:load delay={0.2}>
          <h2>The Philosophy of Tekromancy</h2>
          <p>
            To the uninitiated, modern computing infrastructure often resembles magic: invisible packets traveling trans-oceanic fiber cables in milliseconds, neural networks producing synthetic cognition from matrix multiplications, and distributed consensus algorithms orchestrating millions of containers across disparate clouds.
          </p>
          <p>
            <strong>Tekromancy</strong> exists to peel back the layers of abstraction. We believe that true technical mastery comes from understanding systems down to the metal—how system calls transition across user space and kernel space, how eBPF programs monitor execution at CPU tick resolution, and how network packets traverse the Linux TCP/IP stack.
          </p>
        </ScrollReveal>

        <ScrollReveal client:load delay={0.3}>
          <h2>Core Tenets</h2>
          <ul>
            <li>
              <strong>Sovereignty &amp; Self-Reliance</strong>: Prioritize open-weight models, self-hosted infrastructure, and reproducible deployments over opaque proprietary SaaS lock-in.
            </li>
            <li>
              <strong>Zero-Trust by Default</strong>: Security is not a perimeter wall; it is mutual authentication, in-kernel packet filtering, and continuous least-privilege verification.
            </li>
            <li>
              <strong>Pragmatic Engineering</strong>: Theory without production operational discipline is useless. We focus on real-world configurations, benchmark data, and battle-tested architectures.
            </li>
            <li>
              <strong>Unapologetically Technical</strong>: No generic buzzword summaries or shallow overview articles. We dive directly into configuration files, syscalls, kernel parameters, and executable code.
            </li>
          </ul>
        </ScrollReveal>

        <ScrollReveal client:load delay={0.4}>
          <h2>Domains Explored</h2>
          <div class="not-prose grid sm:grid-cols-2 gap-4 my-8">
            <a href="/blog?tag=linux" class="tk-card p-5 no-underline block">
              <h3 class="text-lg font-bold font-mono mb-2 flex items-center gap-2" style="color: var(--token-color-text-primary, #111827);">
                <Icon name="tabler:terminal-2" class="w-5 h-5 shrink-0" style="color: var(--token-color-primary, #22c55e);" aria-hidden="true" />
                <span>Linux &amp; Kernel</span>
              </h3>
              <p class="text-sm leading-relaxed tk-copy-secondary">
                eBPF tracing, memory allocators, scheduler tuning, systemd architecture, and custom kernel configurations.
              </p>
            </a>
            <a href="/blog?tag=kubernetes" class="tk-card p-5 no-underline block">
              <h3 class="text-lg font-bold font-mono mb-2 flex items-center gap-2" style="color: var(--token-color-text-primary, #111827);">
                <Icon name="tabler:topology-star-3" class="w-5 h-5 shrink-0" style="color: var(--token-color-primary, #22c55e);" aria-hidden="true" />
                <span>Kubernetes &amp; Cloud</span>
              </h3>
              <p class="text-sm leading-relaxed tk-copy-secondary">
                Bare-metal clusters, Cilium CNI, GitOps with ArgoCD, custom controllers, and resilient distributed state.
              </p>
            </a>
            <a href="/blog?tag=ai-ml" class="tk-card p-5 no-underline block">
              <h3 class="text-lg font-bold font-mono mb-2 flex items-center gap-2" style="color: var(--token-color-text-primary, #111827);">
                <Icon name="tabler:brain" class="w-5 h-5 shrink-0" style="color: var(--token-color-primary, #22c55e);" aria-hidden="true" />
                <span>AI / ML Systems</span>
              </h3>
              <p class="text-sm leading-relaxed tk-copy-secondary">
                High-throughput inference with vLLM, PagedAttention, quantization, local agent orchestration, and GPU clustering.
              </p>
            </a>
            <a href="/blog?tag=security" class="tk-card p-5 no-underline block">
              <h3 class="text-lg font-bold font-mono mb-2 flex items-center gap-2" style="color: var(--token-color-text-primary, #111827);">
                <Icon name="tabler:shield-lock" class="w-5 h-5 shrink-0" style="color: var(--token-color-primary, #22c55e);" aria-hidden="true" />
                <span>SecOps &amp; Networking</span>
              </h3>
              <p class="text-sm leading-relaxed tk-copy-secondary">
                WireGuard mesh topologies, BGP routing, nftables, AppArmor enforcement, and zero-day threat mitigation.
              </p>
            </a>
          </div>
        </ScrollReveal>

        <ScrollReveal client:load delay={0.5}>
          <h2>Authors &amp; Technomancers</h2>
          <div class="not-prose grid grid-cols-1 gap-5 my-6">
            {getAllAuthors().map((author) => (
              <div class="tk-card p-6 flex flex-col sm:flex-row items-start sm:items-center gap-6">
                <div
                  class="w-16 h-16 rounded-xl flex items-center justify-center font-mono font-bold text-2xl shrink-0"
                  style="background-color: var(--token-color-primary, #22c55e); color: var(--token-color-primary-foreground, #000000);"
                >
                  {author.initials || 'JC'}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1.5">
                    <h3 class="text-xl font-bold font-mono" style="color: var(--token-color-text-primary, #111827);">
                      {author.name}
                    </h3>
                    {author.role && (
                      <span
                        class="text-xs font-mono px-2.5 py-0.5 rounded border self-start sm:self-auto"
                        style="background-color: var(--token-color-background, #000000); border-color: var(--token-color-border, #1a291f); color: var(--token-color-primary, #22c55e);"
                      >
                        {author.role}
                      </span>
                    )}
                  </div>
                  {author.bio && (
                    <p class="text-sm leading-relaxed mb-3 tk-copy-secondary">
                      {author.bio}
                    </p>
                  )}
                  <div class="flex flex-wrap items-center gap-4 text-xs font-mono">
                    {author.github && (
                      <a
                        href={author.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="tk-focus-ring font-semibold hover:underline"
                        style="color: var(--token-color-primary, #22c55e);"
                      >
                        github ↗
                      </a>
                    )}
                    {author.linkedin && (
                      <a
                        href={author.linkedin}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="tk-focus-ring font-semibold hover:underline tk-copy-meta"
                      >
                        linkedin ↗
                      </a>
                    )}
                    {author.website && (
                      <a
                        href={author.website}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="tk-focus-ring hover:underline tk-copy-meta"
                      >
                        website ↗
                      </a>
                    )}
                    <a
                      href={`/author/${author.id}`}
                      class="tk-focus-ring font-semibold hover:underline sm:ml-auto"
                      style="color: var(--token-color-primary, #22c55e);"
                    >
                      View dispatches →
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </ScrollReveal>

        <ScrollReveal client:load delay={0.6}>
          <div class="not-prose mt-12 flex flex-col sm:flex-row gap-3.5">
            <a href="/blog" class="tk-btn-primary">
              <Icon name="tabler:terminal" class="w-4 h-4" aria-hidden="true" />
              <span>Read Technical Articles</span>
            </a>
            <a href="/contact" class="tk-btn-secondary">
              <Icon name="tabler:mail" class="w-4 h-4" aria-hidden="true" />
              <span>Initiate Contact</span>
            </a>
          </div>
        </ScrollReveal>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
