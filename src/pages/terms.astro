---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config/site.mjs";

const currentMeta = {
	title: "Terms of Service",
	desc: "Terms of Service and conditions for using Tekromancy.",
};

const termsJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
        { "@type": "ListItem", "position": 2, "name": "Terms of Service", "item": `${SITE.url}/terms` }
      ]
    },
    {
      "@type": "WebPage",
      "name": `Terms of Service | ${SITE.title}`,
      "description": currentMeta.desc,
      "url": `${SITE.url}/terms`,
      "publisher": {
        "@type": "Organization",
        "name": SITE.title,
        "logo": {
          "@type": "ImageObject",
          "url": `${SITE.url}/favicon.svg`
        }
      }
    }
  ]
};
---

<Layout
	title={`${currentMeta.title} | ${SITE.title}`}
	description={currentMeta.desc}
	jsonLd={termsJsonLd}
>
	<Header />
	<main class="min-h-screen bg-black text-gray-300 py-24">
		<div class="max-w-4xl mx-auto px-4 sm:px-6">
			<div class="mb-12">
				<h1 class="text-4xl md:text-5xl font-mono font-bold text-white mb-4">Terms of Service</h1>
				<p class="font-mono text-[#22EE44] text-sm">Last Updated: October 10, 2026</p>
			</div>
			
			<div class="prose prose-invert prose-green max-w-none font-sans">
				<h2>1. Acceptance of Terms</h2>
				<p>
					By accessing and using Tekromancy ("the Website"), you accept and agree to be bound by the terms and provision of this agreement. In addition, when using this Website's particular services, you shall be subject to any posted guidelines or rules applicable to such services.
				</p>

				<h2>2. Description of Service</h2>
				<p>
					Tekromancy provides users with access to a rich collection of resources, including technical articles, research papers, tutorials, and specialized software development tools (the "Service"). You understand and agree that the Service is provided "AS-IS" and that Tekromancy assumes no responsibility for the timeliness, deletion, mis-delivery, or failure to store any user communications or personalization settings.
				</p>

				<h2>3. Use of Content</h2>
				<p>
					All editorial content and graphics on this site are protected by copyright and may not be copied without the express permission of Tekromancy, which reserves all rights. Re-use of any of Tekromancy's editorial content and graphics online for any purpose is strictly prohibited. The materials from Tekromancy's sites are available for informational and noncommercial uses offline only, provided the content and/or graphics are not modified in any way, all copyright and other notices on any copy are retained, and permission is granted by Tekromancy.
				</p>

				<h2>4. Disclaimer of Warranties</h2>
				<p>
					The materials on Tekromancy's website are provided on an 'as is' basis. Tekromancy makes no warranties, expressed or implied, and hereby disclaims and negates all other warranties including, without limitation, implied warranties or conditions of merchantability, fitness for a particular purpose, or non-infringement of intellectual property or other violation of rights.
				</p>

				<h2>5. Limitations</h2>
				<p>
					In no event shall Tekromancy or its suppliers be liable for any damages (including, without limitation, damages for loss of data or profit, or due to business interruption) arising out of the use or inability to use the materials on Tekromancy's website, even if Tekromancy or a Tekromancy authorized representative has been notified orally or in writing of the possibility of such damage.
				</p>

				<h2>6. Advertising and AdSense</h2>
				<p>
					We use Google AdSense and other third-party advertising partners to display advertisements on our website. Our partners may use cookies to serve ads based on your prior visits to our website or other websites. Please read our <a href="/privacy">Privacy Policy</a> to learn more about how we use cookies and how you can opt out of personalized advertising.
				</p>

				<h2>7. Links</h2>
				<p>
					Tekromancy has not reviewed all of the sites linked to its website and is not responsible for the contents of any such linked site. The inclusion of any link does not imply endorsement by Tekromancy of the site. Use of any such linked website is at the user's own risk.
				</p>

				<h2>8. Site Terms of Use Modifications</h2>
				<p>
					Tekromancy may revise these terms of service for its website at any time without notice. By using this website you are agreeing to be bound by the then current version of these terms of service.
				</p>

				<h2>9. Contacting Us</h2>
				<p>
					If you have any questions about these Terms, please contact us through our <a href="/contact">Contact Page</a>.
				</p>
			</div>
		</div>
	</main>
	<Footer />
</Layout>
