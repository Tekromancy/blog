---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactForm from "../components/ContactForm.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import { SITE } from "../config/site.mjs";

const linkedinUrl = SITE.linkedin || "https://www.linkedin.com/in/coxjosh/";

const contactJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
        { "@type": "ListItem", "position": 2, "name": "Contact", "item": `${SITE.url}/contact` }
      ]
    },
    {
      "@type": "ContactPage",
      "name": `Contact | ${SITE.title}`,
      "description": "Initiate contact with Tekromancy. Connect directly with Joshua Cox on LinkedIn or submit an architectural transmission.",
      "url": `${SITE.url}/contact`,
      "publisher": {
        "@type": "Organization",
        "name": SITE.title,
        "logo": {
          "@type": "ImageObject",
          "url": `${SITE.url}/favicon.svg`
        }
      }
    }
  ]
};
---

<Layout
  title={`Contact | ${SITE.title}`}
  description="Initiate contact with Tekromancy. Connect directly with Joshua Cox on LinkedIn or submit an architectural transmission."
  canonicalURL={`${SITE.url}/contact`}
  jsonLd={contactJsonLd}
>
  <Header />
  <main id="main-content" role="main" style="background-color: var(--token-color-background, #000000);">
    <section class="max-w-2xl mx-auto px-4 py-16 md:py-20">
      <ScrollReveal client:idle>
        <h1 class="text-4xl md:text-5xl font-extrabold font-mono tracking-tight mb-4 text-balance" style="color: var(--token-color-text-primary, #111827);">
          Initiate Transmission
        </h1>
      </ScrollReveal>
      <ScrollReveal client:idle delay={0.15}>
        <p class="text-lg md:text-xl mb-10 leading-relaxed tk-copy-secondary">
          Have questions about Linux kernel internals, Kubernetes architecture, local LLM pipelines, or security? Connect directly with <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="tk-focus-ring font-semibold underline transition-opacity hover:opacity-80" style="color: var(--token-color-primary, #22c55e);">Joshua Cox on LinkedIn</a> or transmit a dispatch through our public channels.
        </p>
      </ScrollReveal>

      <ScrollReveal client:idle delay={0.25}>
        <ContactForm />
      </ScrollReveal>
    </section>
  </main>
  <Footer />
</Layout>
