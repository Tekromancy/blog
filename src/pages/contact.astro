---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactForm from "../components/ContactForm.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import { SITE } from "../config/site.mjs";
import { Icon } from "astro-icon/components";

const linkedinUrl = SITE.linkedin || "https://www.linkedin.com/in/coxjosh/";

const contactJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
        { "@type": "ListItem", "position": 2, "name": "Contact", "item": `${SITE.url}/contact` }
      ]
    },
    {
      "@type": "ContactPage",
      "name": `Contact | ${SITE.title}`,
      "description": "Initiate contact with Tekromancy. Connect directly with Joshua Cox on LinkedIn or submit an architectural transmission.",
      "url": `${SITE.url}/contact`,
      "publisher": {
        "@type": "Organization",
        "name": SITE.title,
        "logo": {
          "@type": "ImageObject",
          "url": `${SITE.url}/favicon.svg`
        }
      }
    }
  ]
};
---

<Layout
  title={`Contact | ${SITE.title}`}
  description="Initiate contact with Tekromancy. Connect directly with Joshua Cox on LinkedIn or submit an architectural transmission."
  canonicalURL={`${SITE.url}/contact`}
  jsonLd={contactJsonLd}
>
  <Header />
  <main id="main-content" role="main">
    <section class="max-w-2xl mx-auto px-4 py-20">
      <ScrollReveal client:idle>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono mb-4 border" style="background-color: var(--token-color-surface, #1e293b); border-color: var(--token-color-border, #334155); color: var(--token-color-primary, #22EE44);">
          <span style="color: var(--token-color-primary, #22EE44);">// OPEN SOCKET</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold font-mono tracking-tight mb-4" style="color: var(--token-color-text-primary, #111827);">
          Initiate Transmission
        </h1>
      </ScrollReveal>
      <ScrollReveal client:idle delay={0.2}>
        <p class="text-lg md:text-xl mb-8 leading-relaxed" style="color: var(--token-color-text-muted, #374151);">
          Have questions about Linux kernel internals, Kubernetes architecture, local LLM pipelines, or security? Connect directly with <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="font-bold underline decoration-[#0ea5e9] text-[#0ea5e9] hover:text-[#38bdf8] transition-colors">Joshua Cox on LinkedIn</a> or transmit a dispatch through our secure channels.
        </p>
      </ScrollReveal>
      
      <ScrollReveal client:idle delay={0.3}>
        <ContactForm />
      </ScrollReveal>
    </section>
  </main>
  <Footer />
</Layout>

