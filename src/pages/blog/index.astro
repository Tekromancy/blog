---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ScrollReveal from "../../components/ScrollReveal.tsx";
import { getCollection, type CollectionEntry } from "astro:content";
import { SITE } from "../../config/site.mjs";
import { Image } from "astro:assets";
import { getBlogImage } from "../../utils/blogImages";
import { getPostAuthors, formatAuthorNames } from "../../data/authors";
import { getUpcomingEvents } from "../../data/events";

const isDev = import.meta.env.DEV;
const blogPosts = (
	await getCollection("blog", ({ data }) => isDev || !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const upcomingEvents = getUpcomingEvents();

const blogJsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Home",
					"item": SITE.url,
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "Dispatches",
					"item": `${SITE.url}/blog`,
				},
			],
		},
		{
			"@type": "Blog",
			"name": `Articles & Field Notes | ${SITE.title}`,
			"description": "Deep-dive tutorials, system benchmarks, and architecture guides on Linux, Kubernetes, AI/ML engineering, networking, and cybersecurity.",
			"url": `${SITE.url}/blog`,
			"blogPost": blogPosts.map((post) => ({
				"@type": "BlogPosting",
				"headline": post.data.title,
				"datePublished": post.data.pubDate.toISOString(),
				"url": `${SITE.url}/blog/${post.id}`,
				"author": getPostAuthors(post.data).map((author) => ({
					"@type": "Person",
					"name": author.name,
					"url": `${SITE.url}/author/${author.id}`,
				})),
			})),
		},
	],
};
---

<Layout
	title={`Articles & Field Notes | ${SITE.title}`}
	description="Deep-dive tutorials, system benchmarks, and architecture guides on Linux, Kubernetes, AI/ML engineering, networking, and cybersecurity."
	canonicalURL={`${SITE.url}/blog`}
	jsonLd={blogJsonLd}
>
	<Header />
	<main
		id="main-content"
		role="main"
		class="min-h-screen"
		style="background-color: var(--token-color-background, #ffffff);"
	>
		<div class="max-w-7xl mx-auto px-4 py-16 md:py-24">
			<header class="text-center mb-12">
				<ScrollReveal client:load>
					<div
						class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono mb-4 border"
						style="background-color: var(--token-color-surface, #1e293b); border-color: var(--token-color-border, #334155); color: var(--token-color-primary, #22EE44);"
					>
						<span style="color: var(--token-color-primary, #22EE44);"
							>ARCHIVES &amp; TRANSMISSIONS</span
						>
					</div>
					<h1
						class="text-4xl md:text-6xl font-extrabold font-mono tracking-tight mb-4"
						style="color: var(--token-color-text-primary, #111827);"
					>
						Articles &amp; Field Notes
					</h1>
				</ScrollReveal>
				<ScrollReveal client:load delay={0.2}>
					<p
						class="text-lg md:text-xl max-w-2xl mx-auto leading-relaxed"
						style="color: var(--token-color-text-muted, #64748b);"
					>
						Low-level guides, production post-mortems, and architectural
						blueprints for the curious systems engineer.
					</p>
				</ScrollReveal>

				<!-- Cyberpunk Instant Terminal Search Bar -->
				<ScrollReveal client:load delay={0.25}>
					<div class="relative max-w-2xl mx-auto mt-6">
						<div class="relative flex items-center rounded-xl border border-white/10 bg-black/80 px-4 py-2.5 shadow-2xl focus-within:border-[#22EE44] focus-within:ring-1 focus-within:ring-[#22EE44] transition-all">
							<span class="font-mono text-xs sm:text-sm text-[#22EE44] select-none mr-2 font-bold shrink-0">
								root@tekromancy:~$
							</span>
							<input
								id="blog-search-input"
								type="text"
								placeholder="grep -i dispatches, kernel, ebpf, cuda, tags..."
								class="w-full bg-transparent font-mono text-xs sm:text-sm text-white placeholder-gray-500 focus:outline-none"
								aria-label="Search dispatches"
							/>
							<button
								id="search-clear-btn"
								class="hidden font-mono text-xs text-gray-400 hover:text-white px-2 py-0.5 rounded ml-2"
								title="Clear search"
							>
								ESC
							</button>
							<span class="hidden sm:inline-block font-mono text-[10px] text-gray-500 bg-white/5 border border-white/10 px-1.5 py-0.5 rounded select-none shrink-0 ml-2">
								/
							</span>
						</div>
					</div>
				</ScrollReveal>

				<!-- Tag Filter Pills -->
				<ScrollReveal client:load delay={0.3}>
					<div
						class="flex flex-wrap justify-center gap-2 mt-6 text-xs font-mono"
						id="tag-filters"
					>
						<button
							data-filter="all"
							class="filter-btn active px-3.5 py-1.5 rounded-lg border transition-all cursor-pointer font-medium"
							style="background-color: var(--token-color-primary, #0ea5e9); color: var(--token-color-primary-foreground, #ffffff); border-color: var(--token-color-primary, #0ea5e9);"
						>
							All Dispatches
						</button>
						{
							[
								"linux",
								"kubernetes",
								"ai-ml",
								"networking",
								"security",
								"apps",
								"battery",
								"devops",
							].map((t) => (
								<button
									data-filter={t}
									class="filter-btn px-3.5 py-1.5 rounded-lg border transition-all cursor-pointer font-medium"
									style="background-color: var(--token-color-surface, #f8fafc); border-color: var(--token-color-border, #e2e8f0); color: var(--token-color-text-muted, #64748b);"
								>
									#{t}
								</button>
							))
						}
					</div>
				</ScrollReveal>
			</header>

			<!-- Upcoming Events & Field Operations Section -->
			{
				upcomingEvents.length > 0 && (
					<section class="mb-16" aria-labelledby="upcoming-events-heading">
						<ScrollReveal client:load delay={0.35}>
							<div
								class="flex items-center justify-between mb-6 pb-3 border-b"
								style="border-color: var(--token-color-border, #334155);"
							>
								<div class="flex items-center gap-3">
									<span class="relative flex h-3 w-3">
										<span
											class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75"
											style="background-color: var(--token-color-primary, #22EE44);"
										/>
										<span
											class="relative inline-flex rounded-full h-3 w-3"
											style="background-color: var(--token-color-primary, #22EE44);"
										/>
									</span>
									<h2
										id="upcoming-events-heading"
										class="text-xl md:text-2xl font-bold font-mono tracking-tight"
										style="color: var(--token-color-text-primary, #111827);"
									>
										Upcoming Field Operations &amp; Events
									</h2>
								</div>
								<span
									class="font-mono text-xs px-2.5 py-1 rounded-full border hidden sm:inline-block"
									style="background-color: var(--token-color-surface, #1e293b); border-color: var(--token-color-border, #334155); color: var(--token-color-primary, #22EE44);"
								>
									LIVE INTEL // {upcomingEvents.length} ACTIVE
								</span>
							</div>

							<div class="space-y-6">
								{upcomingEvents.map((event) => (
									<div
										class="relative rounded-2xl border p-6 md:p-8 overflow-hidden transition-all duration-300 hover:shadow-xl"
										style="background-color: var(--token-color-surface, #0f172a); border-color: var(--token-color-border, #334155);"
									>
										{/* Background subtle cyber ambient glow */}
										<div
											class="absolute top-0 right-0 w-96 h-96 opacity-10 pointer-events-none rounded-full blur-3xl"
											style="background-color: var(--token-color-primary, #22EE44);"
											aria-hidden="true"
										/>

										{/* Top Badges & Meta */}
										<div class="relative z-10 flex flex-wrap items-center justify-between gap-3 mb-4">
											<div class="flex flex-wrap items-center gap-2">
												<span
													class="px-2.5 py-1 rounded text-xs font-mono font-bold tracking-wider uppercase border"
													style="background-color: var(--token-color-primary, #22EE44); color: var(--token-color-primary-foreground, #000000); border-color: var(--token-color-primary, #22EE44);"
												>
													{event.typeLabel}
												</span>
												<span
													class="px-2.5 py-1 rounded text-xs font-mono font-semibold border flex items-center gap-1.5"
													style="background-color: var(--token-color-surface-elevated, rgba(255,255,255,0.05)); border-color: var(--token-color-border, #334155); color: var(--token-color-primary, #22EE44);"
												>
													<span
														class="w-1.5 h-1.5 rounded-full animate-pulse"
														style="background-color: var(--token-color-primary, #22EE44);"
													/>
													{event.statusLabel}
												</span>
											</div>
											<div
												class="flex items-center gap-1.5 text-xs font-mono px-3 py-1 rounded border"
												style="background-color: var(--token-color-surface-elevated, rgba(255,255,255,0.03)); border-color: var(--token-color-border, #334155); color: var(--token-color-text-muted, #94a3b8);"
											>
												<svg
													class="w-3.5 h-3.5"
													fill="none"
													stroke="currentColor"
													viewBox="0 0 24 24"
													style="color: var(--token-color-primary, #22EE44);"
												>
													<path
														stroke-linecap="round"
														stroke-linejoin="round"
														stroke-width="2"
														d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
													/>
													<path
														stroke-linecap="round"
														stroke-linejoin="round"
														stroke-width="2"
														d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
													/>
												</svg>
												<span>{event.location}</span>
												{event.venue && (
													<span class="opacity-70 hidden md:inline">
														({event.venue})
													</span>
												)}
											</div>
										</div>

										{/* Title & Organization */}
										<div class="relative z-10 mb-4">
											<h3
												class="text-2xl md:text-3xl font-extrabold font-mono mb-2 tracking-tight"
												style="color: var(--token-color-text-primary, #f8fafc);"
											>
												{event.title}
											</h3>
											<div
												class="flex flex-wrap items-center gap-1.5 text-xs md:text-sm font-mono"
												style="color: var(--token-color-text-muted, #94a3b8);"
											>
												<span>In association with</span>
												<a
													href={event.orgUrl}
													target="_blank"
													rel="noopener noreferrer"
													class="font-bold underline decoration-dotted transition-opacity hover:opacity-80"
													style="color: var(--token-color-primary, #22EE44);"
												>
													{event.organization} (
													{event.displayOrgUrl || "aicyberalliance.org"}) ↗
												</a>
											</div>
										</div>

										{/* Description */}
										<p
											class="relative z-10 text-sm md:text-base leading-relaxed mb-6 max-w-4xl"
											style="color: var(--token-color-text-muted, #cbd5e1);"
										>
											{event.description}
										</p>

										{/* Operational Tracks / Highlights */}
										{event.highlights && event.highlights.length > 0 && (
											<div
												class="relative z-10 mb-6 p-4 rounded-xl border"
												style="background-color: var(--token-color-background, #020617); border-color: var(--token-color-border, #334155);"
											>
												<div
													class="text-xs font-mono font-semibold uppercase tracking-wider mb-3"
													style="color: var(--token-color-primary, #22EE44);"
												>
													// Operational Tracks &amp; Challenge Vectors
												</div>
												<div
													class="grid grid-cols-1 md:grid-cols-2 gap-2.5 text-xs font-mono"
													style="color: var(--token-color-text-primary, #f1f5f9);"
												>
													{event.highlights.map((h) => (
														<div class="flex items-start gap-2">
															<span
																class="font-bold shrink-0"
																style="color: var(--token-color-primary, #22EE44);"
															>
																[+]
															</span>
															<span>{h}</span>
														</div>
													))}
												</div>
											</div>
										)}

										{/* Tags & CTAs Footer */}
										<div
											class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-4 border-t"
											style="border-color: var(--token-color-border, #334155);"
										>
											<div class="flex flex-wrap gap-1.5">
												{event.tags.map((t) => (
													<span
														class="text-[11px] font-mono px-2 py-0.5 rounded border"
														style="background-color: var(--token-color-surface-elevated, rgba(255,255,255,0.03)); border-color: var(--token-color-border, #334155); color: var(--token-color-text-muted, #94a3b8);"
													>
														#{t}
													</span>
												))}
											</div>
											<div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
												{event.secondaryCta && (
													<a
														href={event.secondaryCta.url}
														class="px-3.5 py-2 rounded-lg font-mono text-xs font-semibold border transition-all hover:scale-[1.02] flex items-center gap-1.5"
														style="background-color: var(--token-color-surface-elevated, rgba(255,255,255,0.04)); border-color: var(--token-color-border, #334155); color: var(--token-color-text-primary, #f8fafc);"
													>
														<span>{event.secondaryCta.label}</span>
													</a>
												)}
												<a
													href={event.primaryCta.url}
													target="_blank"
													rel="noopener noreferrer"
													class="px-4 py-2 rounded-lg font-mono text-xs font-bold transition-all shadow-md hover:scale-[1.02] flex items-center gap-1.5"
													style="background-color: var(--token-color-primary, #22EE44); color: var(--token-color-primary-foreground, #000000);"
												>
													<span>{event.primaryCta.label}</span>
												</a>
											</div>
										</div>
									</div>
								))}
							</div>
						</ScrollReveal>
					</section>
				)
			}

			<!-- Active Author Filter Banner -->
			<div
				id="author-filter-banner"
				class="hidden mb-6 p-4 rounded-xl border font-mono text-xs flex items-center justify-between"
				style="background-color: var(--token-color-surface, #0e0a12); border-color: var(--token-color-border, #334155); color: var(--token-color-text-primary, #ffffff);"
			>
				<div class="flex items-center gap-2">
					<span
						class="w-2 h-2 rounded-full inline-block"
						style="background-color: var(--token-color-primary, #22EE44);"
					></span>
					<span
						>FILTERED BY AUTHOR: <strong
							id="author-filter-name"
							style="color: var(--token-color-primary, #22EE44);"
						></strong></span
					>
				</div>
				<a
					href="/blog"
					class="px-2.5 py-1 rounded border hover:underline"
					style="border-color: var(--token-color-border, #334155); color: var(--token-color-text-muted, #94a3b8);"
				>
					Clear Filter ×
				</a>
			</div>

			<!-- Dispatches Section Header -->
			<div
				class="flex items-center justify-between mb-6 pb-3 border-b"
				style="border-color: var(--token-color-border, #334155);"
			>
				<div
					class="flex items-center gap-2 text-sm font-mono font-semibold"
					style="color: var(--token-color-text-primary, #111827);"
				>
					<span style="color: var(--token-color-primary, #22EE44);">&gt;_</span>
					<span>ARCHIVED DISPATCHES &amp; TRANSMISSIONS</span>
				</div>
				<span
					class="font-mono text-xs"
					style="color: var(--token-color-text-muted, #64748b);"
				>
					{blogPosts.length} entries
				</span>
			</div>

			{
				blogPosts.length === 0 ? (
					<div class="text-center py-12">
						<p style="color: var(--token-color-text-muted, #64748b);">
							No articles found in this archive.
						</p>
					</div>
				) : (
					<div
						class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
						id="posts-grid"
					>
						{blogPosts.map((post, index) => {
							const heroImage = getBlogImage(post.data.heroImage);
							const tags = post.data.tags || [];
							const firstTag = tags.length > 0 ? tags[0] : null;
							const authors = getPostAuthors(post.data);
							const authorNamesStr = formatAuthorNames(authors);
							return (
								<article
									class="post-card rounded-xl border hover:shadow-lg transition-all duration-200 overflow-hidden flex flex-col"
									data-tags={tags.join(",")}
									data-title={post.data.title.toLowerCase()}
									data-desc={post.data.description.toLowerCase()}
									data-authors={authors
										.map((a) => a.name.toLowerCase())
										.join("|")}
									style="background-color: var(--token-color-background, #ffffff); border-color: var(--token-color-border, #e5e7eb);"
								>
									{heroImage ? (
										<a href={`/blog/${post.id}`} class="block w-full h-48 md:h-52 overflow-hidden rounded-t-xl relative group">
											<Image
												src={heroImage}
												alt={post.data.title}
												transition:name={`blog-image-${post.id}`}
												class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
												loading="lazy"
												widths={[400, 800, 1200]}
												sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
											/>
										</a>
									) : (
										<a href={`/blog/${post.id}`} class="block w-full h-32 flex items-center justify-between px-6 rounded-t-xl border-b hover:bg-slate-50 transition-colors" style="background-color: var(--token-color-surface, #f8fafc); border-color: var(--token-color-border, #e2e8f0);">
											<span class="font-mono text-xs opacity-75" style="color: var(--token-color-primary, #0ea5e9);">
												&gt;_ sys.dispatch
											</span>
											<span class="font-mono text-xs" style="color: var(--token-color-text-muted, #64748b);">
												tekromancy.com
											</span>
										</a>
									)}
									<div class="p-6 flex flex-col flex-1">
										<div class="flex items-center justify-between gap-3 mb-2 text-xs font-mono" style="color: var(--token-color-text-muted, #64748b);">
											<time datetime={post.data.pubDate.toISOString()}>
												{post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
											</time>
											<div class="flex items-center gap-1.5">
												{post.data.draft && (
													<span class="px-2 py-0.5 rounded font-mono font-bold text-[10px] tracking-wider uppercase border border-amber-500/60 bg-amber-500/20 text-amber-300">
														DRAFT
													</span>
												)}
												{firstTag && (
													<a href={`/tags/${encodeURIComponent(firstTag)}`} class="px-2 py-0.5 rounded font-mono font-medium hover:underline transition-colors" style="background-color: var(--token-color-surface, #f1f5f9); color: var(--token-color-primary, #0ea5e9);">
														#{firstTag}
													</a>
												)}
											</div>
										</div>
										<div class="text-[11px] font-mono mb-3 flex flex-wrap items-center gap-1.5" style="color: var(--token-color-primary, #22EE44);">
											<span class="opacity-70">by</span>
											{getPostAuthors(post.data).map((author, i, arr) => (
												<span class="inline-flex items-center">
													<a href={`/author/${author.id}`} class="font-medium hover:underline">
														{author.name}
													</a>
													{i < arr.length - 2 ? (
														<span>, </span>
													) : i === arr.length - 2 ? (
														<span class="opacity-75 mx-1">&amp;</span>
													) : null}
												</span>
											))}
										</div>
										<h2 class="text-xl font-bold font-mono mb-3 transition-colors line-clamp-2" style="color: var(--token-color-text-primary, #111827);">
											<a href={`/blog/${post.id}`} class="hover:text-[var(--token-color-primary)]">
												{post.data.title}
											</a>
										</h2>
										<p class="text-sm leading-relaxed flex-1 line-clamp-3 mb-4" style="color: var(--token-color-text-muted, #64748b);">
											{post.data.description}
										</p>
										<div class="pt-4 border-t flex items-center justify-between text-xs font-mono" style="border-color: var(--token-color-border, #e5e7eb); color: var(--token-color-primary, #0ea5e9);">
											<a href={`/blog/${post.id}`} class="inline-flex items-center gap-1 hover:underline group">
												<span>Read article</span>
												<span class="transition-transform group-hover:translate-x-1">→</span>
											</a>
										</div>
									</div>
								</article>
							);
						})}
					</div>
				)
			}
		</div>
	</main>
	<Footer />
</Layout>

<script is:inline>
	(function () {
		function setupFilter() {
			var filterBtns = document.querySelectorAll(".filter-btn");
			var cards = document.querySelectorAll(".post-card");
			var searchInput = document.getElementById("blog-search-input");
			var clearBtn = document.getElementById("search-clear-btn");
			var currentFilter = "all";
			var currentQuery = "";
			if (!filterBtns.length) return;

			function updateVisibility() {
				var q = currentQuery.toLowerCase().trim();
				var visibleCount = 0;

				cards.forEach(function (card) {
					var tags = (card.getAttribute("data-tags") || "").split(",");
					var title = card.getAttribute("data-title") || "";
					var desc = card.getAttribute("data-desc") || "";

					var matchesTag = currentFilter === "all" || tags.indexOf(currentFilter) !== -1;
					var matchesQuery = !q || title.indexOf(q) !== -1 || desc.indexOf(q) !== -1 || tags.some(function(t) { return t.indexOf(q) !== -1; });

					if (matchesTag && matchesQuery) {
						card.style.display = "flex";
						visibleCount++;
					} else {
						card.style.display = "none";
					}
				});

				if (clearBtn) {
					if (q) {
						clearBtn.classList.remove("hidden");
					} else {
						clearBtn.classList.add("hidden");
					}
				}
			}

			function applyFilter(filter) {
				currentFilter = filter;
				filterBtns.forEach(function (btn) {
					var match = btn.getAttribute("data-filter") === filter;
					if (match) {
						btn.style.backgroundColor = "var(--token-color-primary, #0ea5e9)";
						btn.style.color = "var(--token-color-primary-foreground, #ffffff)";
						btn.style.borderColor = "var(--token-color-primary, #0ea5e9)";
					} else {
						btn.style.backgroundColor = "var(--token-color-surface, #f8fafc)";
						btn.style.color = "var(--token-color-text-muted, #64748b)";
						btn.style.borderColor = "var(--token-color-border, #e2e8f0)";
					}
				});
				updateVisibility();
			}

			var authorBanner = document.getElementById("author-filter-banner");
			var authorNameEl = document.getElementById("author-filter-name");

			function applyAuthorFilter(authorName) {
				if (!authorName) return;
				var target = authorName.toLowerCase().trim();
				if (authorBanner && authorNameEl) {
					authorBanner.classList.remove("hidden");
					authorNameEl.textContent = authorName;
				}
				filterBtns.forEach(function (btn) {
					btn.style.backgroundColor = "var(--token-color-surface, #f8fafc)";
					btn.style.color = "var(--token-color-text-muted, #64748b)";
					btn.style.borderColor = "var(--token-color-border, #e2e8f0)";
				});
				cards.forEach(function (card) {
					var authors = (card.getAttribute("data-authors") || "").split("|");
					var matched = authors.some(function (a) {
						return a.indexOf(target) !== -1 || target.indexOf(a) !== -1;
					});
					if (matched) {
						card.style.display = "flex";
					} else {
						card.style.display = "none";
					}
				});
			}

			var searchDebounceTimer = null;
			if (searchInput) {
				searchInput.oninput = function(e) {
					currentQuery = e.target.value;
					updateVisibility();
					var url = new URL(window.location);
					if (currentQuery.trim()) {
						url.searchParams.set("q", currentQuery.trim());
					} else {
						url.searchParams.delete("q");
					}
					window.history.replaceState({}, "", url);

					clearTimeout(searchDebounceTimer);
					var trimmedQ = currentQuery.trim();
					if (trimmedQ.length >= 2) {
						searchDebounceTimer = setTimeout(function() {
							if (typeof window.trackTelemetry === "function") {
								var matchCount = 0;
								cards.forEach(function(c) {
									if (c.style.display !== "none") matchCount++;
								});
								window.trackTelemetry("internal_search", {
									query: trimmedQ,
									result_count: matchCount
								});
							}
						}, 750);
					}
				};
			}

			if (clearBtn) {
				clearBtn.onclick = function() {
					if (searchInput) searchInput.value = "";
					currentQuery = "";
					updateVisibility();
					var url = new URL(window.location);
					url.searchParams.delete("q");
					window.history.replaceState({}, "", url);
				};
			}

			// Key listener for '/' to focus search input
			window.addEventListener("keydown", function(e) {
				if ((e.key === "/" && document.activeElement !== searchInput) || (e.ctrlKey && e.key === "k") || (e.metaKey && e.key === "k")) {
					e.preventDefault();
					searchInput && searchInput.focus();
				}
			});

			filterBtns.forEach(function (btn) {
				btn.onclick = function () {
					if (authorBanner) authorBanner.classList.add("hidden");
					var filter = btn.getAttribute("data-filter");
					applyFilter(filter);
					var url = new URL(window.location);
					url.searchParams.delete("author");
					if (filter === "all") {
						url.searchParams.delete("tag");
					} else {
						url.searchParams.set("tag", filter);
					}
					window.history.replaceState({}, "", url);
				};
			});

			var params = new URLSearchParams(window.location.search);
			var authorParam = params.get("author");
			var tagParam = params.get("tag");
			var queryParam = params.get("q");

			if (queryParam && searchInput) {
				searchInput.value = queryParam;
				currentQuery = queryParam;
			}

			if (authorParam) {
				applyAuthorFilter(authorParam);
			} else if (tagParam) {
				applyFilter(tagParam);
			} else if (queryParam) {
				updateVisibility();
			}
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", setupFilter);
		} else {
			setupFilter();
		}
		document.addEventListener("astro:page-load", setupFilter);
		document.addEventListener("astro:after-swap", setupFilter);
	})();
</script>

<style>
	/* Critical CSS: Ensure border-radius is applied immediately to prevent FOUC */
	article a > div img,
	article a > div[data-astro-cid] img,
	article a > div > img {
		border-radius: 0.5rem 0.5rem 0 0;
	}
</style>
