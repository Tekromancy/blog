---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ScrollReveal from "../../components/ScrollReveal.tsx";
import { getCollection } from "astro:content";
import { SITE } from "../../config/site.mjs";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getBlogImage } from "../../utils/blogImages";
import { getPostAuthors } from "../../data/authors";
import { getUpcomingEvents } from "../../data/events";

const isDev = import.meta.env.DEV;
const blogPosts = (
	await getCollection("blog", ({ data }) => isDev || !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const upcomingEvents = getUpcomingEvents();

const blogJsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Home",
					"item": SITE.url,
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "Dispatches",
					"item": `${SITE.url}/blog`,
				},
			],
		},
		{
			"@type": "Blog",
			"name": `Articles & Field Notes | ${SITE.title}`,
			"description": "Deep-dive tutorials, system benchmarks, and architecture guides on Linux, Kubernetes, AI/ML engineering, networking, and cybersecurity.",
			"url": `${SITE.url}/blog`,
			"blogPost": blogPosts.map((post) => ({
				"@type": "BlogPosting",
				"headline": post.data.title,
				"datePublished": post.data.pubDate.toISOString(),
				"url": `${SITE.url}/blog/${post.id}`,
				"author": getPostAuthors(post.data).map((author) => ({
					"@type": "Person",
					"name": author.name,
					"url": `${SITE.url}/author/${author.id}`,
				})),
			})),
		},
	],
};
---

<Layout
	title={`Articles & Field Notes | ${SITE.title}`}
	description="Deep-dive tutorials, system benchmarks, and architecture guides on Linux, Kubernetes, AI/ML engineering, networking, and cybersecurity."
	canonicalURL={`${SITE.url}/blog`}
	jsonLd={blogJsonLd}
>
	<Header />
	<main
		id="main-content"
		role="main"
		class="min-h-screen"
		style="background-color: var(--token-color-background, #000000);"
	>
		<div class="max-w-6xl mx-auto px-4 py-16 md:py-20">
			<header class="text-center mb-14">
				<ScrollReveal client:load>
					<h1
						class="text-4xl md:text-6xl font-extrabold font-mono tracking-tight mb-4 text-balance"
						style="color: var(--token-color-text-primary, #111827);"
					>
						Articles &amp; Field Notes
					</h1>
				</ScrollReveal>
				<ScrollReveal client:load delay={0.15}>
					<p class="text-lg md:text-xl max-w-2xl mx-auto leading-relaxed tk-copy-secondary">
						Low-level guides, production post-mortems, and architectural
						blueprints for the curious systems engineer.
					</p>
				</ScrollReveal>

				<!-- CLI Grep Search Input Well -->
				<ScrollReveal client:load delay={0.2}>
					<div class="relative max-w-2xl mx-auto mt-8">
						<div class="tk-cli-well">
							<span
								class="font-mono text-xs sm:text-sm select-none font-bold shrink-0"
								style="color: var(--token-color-primary, #22c55e);"
							>
								root@tekromancy:~$
							</span>
							<input
								id="blog-search-input"
								type="text"
								placeholder="grep -i dispatches, kernel, ebpf, cuda, tags..."
								class="tk-cli-input"
								aria-label="Search dispatches"
							/>
							<button
								id="search-clear-btn"
								type="button"
								class="hidden tk-focus-ring font-mono text-xs px-2 py-0.5 rounded border cursor-pointer shrink-0"
								style="background-color: var(--token-color-background, #000000); border-color: var(--token-color-border, #1a291f); color: var(--token-color-text-primary, #111827);"
								title="Clear search (Escape)"
							>
								ESC
							</button>
							<span
								class="hidden sm:inline-block font-mono text-[10px] px-1.5 py-0.5 rounded border select-none shrink-0 tk-copy-meta"
								style="background-color: var(--token-color-background, #000000); border-color: var(--token-color-border, #1a291f);"
							>
								/
							</span>
						</div>
					</div>
				</ScrollReveal>

				<!-- Tag Filter Chips -->
				<ScrollReveal client:load delay={0.25}>
					<div
						class="flex flex-wrap justify-center gap-2 mt-6 text-xs font-mono"
						id="tag-filters"
						role="group"
						aria-label="Filter dispatches by domain tag"
					>
						<button
							type="button"
							data-filter="all"
							aria-pressed="true"
							class="filter-btn tk-focus-ring px-3.5 py-1.5 rounded-full border transition-all cursor-pointer font-semibold"
							style="background-color: var(--token-color-primary, #22c55e); color: var(--token-color-primary-foreground, #000000); border-color: var(--token-color-primary, #22c55e);"
						>
							#all
						</button>
						{
							[
								"linux",
								"kubernetes",
								"ai-ml",
								"networking",
								"security",
								"storage",
								"apps",
								"devops",
							].map((t) => (
								<button
									type="button"
									data-filter={t}
									aria-pressed="false"
									class="filter-btn tk-focus-ring px-3.5 py-1.5 rounded-full border transition-all cursor-pointer font-medium"
									style="background-color: var(--token-color-surface, #0a0e0b); border-color: var(--token-color-border, #1a291f); color: var(--token-color-text-primary, #111827);"
								>
									#{t}
								</button>
							))
						}
					</div>
				</ScrollReveal>
			</header>

			<!-- Upcoming Events & Field Operations Section -->
			{
				upcomingEvents.length > 0 && (
					<section class="mb-16" id="upcoming-events-section" aria-labelledby="upcoming-events-heading">
						<ScrollReveal client:load delay={0.3}>
							<div
								class="flex items-center justify-between mb-6 pb-3 border-b"
								style="border-color: var(--token-color-border, #1a291f);"
							>
								<div class="flex items-center gap-3">
									<span class="relative flex h-2.5 w-2.5" aria-hidden="true">
										<span
											class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75"
											style="background-color: var(--token-color-primary, #22c55e);"
										/>
										<span
											class="relative inline-flex rounded-full h-2.5 w-2.5"
											style="background-color: var(--token-color-primary, #22c55e);"
										/>
									</span>
									<h2
										id="upcoming-events-heading"
										class="text-xl md:text-2xl font-bold font-mono tracking-tight"
										style="color: var(--token-color-text-primary, #111827);"
									>
										Upcoming Field Operations &amp; Events
									</h2>
								</div>
								<span
									class="font-mono text-xs px-2.5 py-1 rounded-full border hidden sm:inline-block tk-tabular"
									style="background-color: var(--token-color-surface, #0a0e0b); border-color: var(--token-color-border, #1a291f); color: var(--token-color-primary, #22c55e);"
								>
									{upcomingEvents.length} ACTIVE
								</span>
							</div>

							<div class="space-y-6">
								{upcomingEvents.map((event) => (
									<article class="tk-plate p-6 md:p-8 relative overflow-hidden">
										{/* Top Badges & Meta */}
										<div class="relative z-10 flex flex-wrap items-center justify-between gap-3 mb-4">
											<div class="flex flex-wrap items-center gap-2">
												<span
													class="px-2.5 py-1 rounded text-xs font-mono font-bold tracking-wider uppercase"
													style="background-color: var(--token-color-primary, #22c55e); color: var(--token-color-primary-foreground, #000000);"
												>
													{event.typeLabel}
												</span>
												<span
													class="px-2.5 py-1 rounded text-xs font-mono font-semibold border flex items-center gap-1.5"
													style="background-color: var(--token-color-background, #000000); border-color: var(--token-color-border, #1a291f); color: var(--token-color-primary, #22c55e);"
												>
													<span
														class="w-1.5 h-1.5 rounded-full animate-pulse"
														style="background-color: var(--token-color-primary, #22c55e);"
													/>
													{event.statusLabel}
												</span>
											</div>
											<div
												class="flex items-center gap-1.5 text-xs font-mono px-3 py-1 rounded border tk-copy-meta"
												style="background-color: var(--token-color-background, #000000); border-color: var(--token-color-border, #1a291f);"
											>
												<Icon name="tabler:map-pin" class="w-3.5 h-3.5 shrink-0" style="color: var(--token-color-primary, #22c55e);" aria-hidden="true" />
												<span>{event.location}</span>
												{event.venue && (
													<span class="opacity-75 hidden md:inline">
														({event.venue})
													</span>
												)}
											</div>
										</div>

										{/* Title & Organization */}
										<div class="relative z-10 mb-4">
											<h3
												class="text-2xl md:text-3xl font-extrabold font-mono mb-2 tracking-tight"
												style="color: var(--token-color-text-primary, #111827);"
											>
												{event.title}
											</h3>
											<div class="flex flex-wrap items-center gap-1.5 text-xs md:text-sm font-mono tk-copy-meta">
												<span>In association with</span>
												<a
													href={event.orgUrl}
													target="_blank"
													rel="noopener noreferrer"
													class="tk-focus-ring font-bold underline decoration-dotted transition-opacity hover:opacity-80"
													style="color: var(--token-color-primary, #22c55e);"
												>
													{event.organization} (
													{event.displayOrgUrl || "aicyberalliance.org"}) ↗
												</a>
											</div>
										</div>

										{/* Description */}
										<p class="relative z-10 text-sm md:text-base leading-relaxed mb-6 max-w-4xl tk-copy-secondary">
											{event.description}
										</p>

										{/* Operational Tracks — 1px Hairline Decomposition (No Nested Card) */}
										{event.highlights && event.highlights.length > 0 && (
											<div
												class="relative z-10 mb-6 pt-5 border-t"
												style="border-color: var(--token-color-border, #1a291f);"
											>
												<div
													class="text-xs font-mono font-semibold uppercase tracking-wider mb-3"
													style="color: var(--token-color-primary, #22c55e);"
												>
													Operational Tracks &amp; Challenge Vectors
												</div>
												<div class="grid grid-cols-1 md:grid-cols-2 gap-2.5 text-xs font-mono tk-copy-secondary">
													{event.highlights.map((h) => (
														<div class="flex items-start gap-2">
															<Icon name="tabler:chevron-right" class="w-4 h-4 shrink-0 mt-0.5" style="color: var(--token-color-primary, #22c55e);" aria-hidden="true" />
															<span>{h}</span>
														</div>
													))}
												</div>
											</div>
										)}

										{/* Tags & CTAs Footer */}
										<div
											class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-4 border-t"
											style="border-color: var(--token-color-border, #1a291f);"
										>
											<div class="flex flex-wrap gap-1.5">
												{event.tags.map((t) => (
													<span
														class="text-[11px] font-mono px-2 py-0.5 rounded border tk-copy-meta"
														style="background-color: var(--token-color-background, #000000); border-color: var(--token-color-border, #1a291f);"
													>
														#{t}
													</span>
												))}
											</div>
											<div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
												{event.secondaryCta && (
													<a
														href={event.secondaryCta.url}
														class="tk-btn-secondary !py-2 !px-4 !text-xs"
													>
														<span>{event.secondaryCta.label}</span>
													</a>
												)}
												<a
													href={event.primaryCta.url}
													target="_blank"
													rel="noopener noreferrer"
													class="tk-btn-primary !py-2 !px-4 !text-xs"
												>
													<span>{event.primaryCta.label}</span>
													<Icon name="tabler:arrow-up-right" class="w-3.5 h-3.5" aria-hidden="true" />
												</a>
											</div>
										</div>
									</article>
								))}
							</div>
						</ScrollReveal>
					</section>
				)
			}

			<!-- Active Author Filter Banner -->
			<div
				id="author-filter-banner"
				class="hidden mb-6 p-4 rounded-xl border font-mono text-xs flex items-center justify-between"
				style="background-color: var(--token-color-surface, #0a0e0b); border-color: var(--token-color-border, #1a291f); color: var(--token-color-text-primary, #111827);"
			>
				<div class="flex items-center gap-2">
					<span
						class="w-2 h-2 rounded-full inline-block"
						style="background-color: var(--token-color-primary, #22c55e);"
					></span>
					<span
						>FILTERED BY AUTHOR: <strong
							id="author-filter-name"
							style="color: var(--token-color-primary, #22c55e);"
						></strong></span
					>
				</div>
				<a
					href="/blog"
					class="tk-focus-ring px-2.5 py-1 rounded border hover:underline tk-copy-meta"
					style="border-color: var(--token-color-border, #1a291f);"
				>
					Clear Filter ×
				</a>
			</div>

			<!-- Dispatches Section Header -->
			<div
				class="flex items-center justify-between mb-6 pb-3 border-b"
				style="border-color: var(--token-color-border, #1a291f);"
			>
				<div
					class="flex items-center gap-2 text-sm font-mono font-semibold"
					style="color: var(--token-color-text-primary, #111827);"
				>
					<span style="color: var(--token-color-primary, #22c55e);">&gt;_</span>
					<span>ARCHIVED DISPATCHES &amp; TRANSMISSIONS</span>
				</div>
				<span
					id="visible-posts-count"
					class="font-mono text-xs tk-copy-meta"
					aria-live="polite"
				>
					{blogPosts.length} entries
				</span>
			</div>

			<!-- Zero-Results Empty State -->
			<div
				id="no-search-results"
				class="hidden py-14 px-6 text-center rounded-2xl border max-w-2xl mx-auto my-8 font-mono space-y-3"
				style="background-color: var(--token-color-surface, #0a0e0b); border-color: var(--token-color-border, #1a291f);"
				role="status"
				aria-live="polite"
			>
				<div class="inline-flex items-center justify-center w-11 h-11 rounded-xl border mb-1" style="background-color: var(--token-color-background, #000000); border-color: var(--token-color-border, #1a291f); color: var(--token-color-error, #ef4444);">
					<Icon name="tabler:search-off" class="w-5 h-5" aria-hidden="true" />
				</div>
				<div class="text-sm font-bold" style="color: var(--token-color-text-primary, #111827);">
					NO DISPATCHES MATCHING QUERY VECTOR
				</div>
				<p class="text-xs max-w-md mx-auto tk-copy-secondary">
					No articles matched your active filter or grep pattern. Clear the search query or reset back to all dispatches.
				</p>
				<div class="pt-2">
					<button
						type="button"
						id="reset-filters-btn"
						class="tk-btn-primary !py-2 !px-4 !text-xs"
					>
						<span>Reset All Filters</span>
					</button>
				</div>
			</div>

			{
				blogPosts.length === 0 ? (
					<div class="text-center py-12">
						<p class="tk-copy-secondary">
							No articles found in this archive.
						</p>
					</div>
				) : (
					<div
						class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
						id="posts-grid"
					>
						{blogPosts.map((post) => {
							const heroImage = getBlogImage(post.data.heroImage);
							const tags = post.data.tags || [];
							const firstTag = tags.length > 0 ? tags[0] : null;
							const authors = getPostAuthors(post.data);
							return (
								<article
									class="post-card tk-card overflow-hidden flex flex-col group"
									data-tags={tags.join(",")}
									data-title={post.data.title.toLowerCase()}
									data-desc={post.data.description.toLowerCase()}
									data-authors={authors
										.map((a) => a.name.toLowerCase())
										.join("|")}
								>
									{heroImage ? (
										<a
											href={`/blog/${post.id}`}
											class="block w-full aspect-video overflow-hidden relative border-b"
											style="border-color: var(--token-color-border, #1a291f);"
										>
											<Image
												src={heroImage}
												alt={post.data.title}
												transition:name={`blog-image-${post.id}`}
												class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
												loading="lazy"
												widths={[400, 800, 1200]}
												sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
											/>
										</a>
									) : (
										<a
											href={`/blog/${post.id}`}
											class="block w-full h-32 flex items-center justify-between px-6 border-b transition-colors"
											style="background-color: var(--token-color-background, #000000); border-color: var(--token-color-border, #1a291f);"
										>
											<span class="font-mono text-xs" style="color: var(--token-color-primary, #22c55e);">
												&gt;_ sys.dispatch
											</span>
											<span class="font-mono text-xs tk-copy-meta">
												tekromancy.com
											</span>
										</a>
									)}
									<div class="p-6 flex flex-col flex-1">
										<div class="flex items-center justify-between gap-3 mb-2 text-xs font-mono tk-copy-meta">
											<time datetime={post.data.pubDate.toISOString()}>
												{post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
											</time>
											<div class="flex items-center gap-1.5">
												{post.data.draft && (
													<span class="px-2 py-0.5 rounded font-mono font-bold text-[10px] tracking-wider uppercase border border-amber-500/60 bg-amber-500/20 text-amber-300">
														DRAFT
													</span>
												)}
												{firstTag && (
													<a
														href={`/tags/${encodeURIComponent(firstTag)}`}
														class="px-2 py-0.5 rounded font-mono font-semibold hover:underline transition-colors border"
														style="background-color: var(--token-color-background, #000000); border-color: var(--token-color-border, #1a291f); color: var(--token-color-primary, #22c55e);"
													>
														#{firstTag}
													</a>
												)}
											</div>
										</div>
										<div class="text-[11px] font-mono mb-3 flex flex-wrap items-center gap-1.5" style="color: var(--token-color-primary, #22c55e);">
											<span class="tk-copy-meta">by</span>
											{authors.map((author, i, arr) => (
												<span class="inline-flex items-center">
													<a href={`/author/${author.id}`} class="font-medium hover:underline">
														{author.name}
													</a>
													{i < arr.length - 2 ? (
														<span>, </span>
													) : i === arr.length - 2 ? (
														<span class="opacity-75 mx-1">&amp;</span>
													) : null}
												</span>
											))}
										</div>
										<h2 class="text-lg md:text-xl font-bold font-mono mb-3 transition-colors line-clamp-2" style="color: var(--token-color-text-primary, #111827);">
											<a href={`/blog/${post.id}`} class="hover:text-[var(--token-color-primary)]">
												{post.data.title}
											</a>
										</h2>
										<p class="text-sm leading-relaxed flex-1 line-clamp-3 mb-4 tk-copy-secondary">
											{post.data.description}
										</p>
										<div class="pt-4 border-t flex items-center justify-between text-xs font-mono" style="border-color: var(--token-color-border, #1a291f); color: var(--token-color-primary, #22c55e);">
											<a href={`/blog/${post.id}`} class="tk-focus-ring inline-flex items-center gap-1.5 font-semibold hover:underline">
												<span>Read article</span>
												<Icon name="tabler:arrow-right" class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" aria-hidden="true" />
											</a>
										</div>
									</div>
								</article>
							);
						})}
					</div>
				)
			}
		</div>
	</main>
	<Footer />
</Layout>

<script is:inline>
	(function () {
		function setupFilter() {
			var filterBtns = document.querySelectorAll(".filter-btn");
			var cards = document.querySelectorAll(".post-card");
			var postsGrid = document.getElementById("posts-grid");
			var emptyState = document.getElementById("no-search-results");
			var resetBtn = document.getElementById("reset-filters-btn");
			var countEl = document.getElementById("visible-posts-count");
			var searchInput = document.getElementById("blog-search-input");
			var clearBtn = document.getElementById("search-clear-btn");
			var currentFilter = "all";
			var currentQuery = "";
			var totalCount = cards.length;
			if (!filterBtns.length) return;

			function updateCountAndEmpty(visibleCount) {
				if (countEl) {
					countEl.textContent =
						visibleCount === totalCount
							? totalCount + " entries"
							: visibleCount + " of " + totalCount + " entries";
				}
				if (emptyState && postsGrid) {
					if (visibleCount === 0 && totalCount > 0) {
						emptyState.classList.remove("hidden");
						postsGrid.classList.add("hidden");
					} else {
						emptyState.classList.add("hidden");
						postsGrid.classList.remove("hidden");
					}
				}
			}

			function updateVisibility() {
				var q = currentQuery.toLowerCase().trim();
				var visibleCount = 0;

				cards.forEach(function (card) {
					var tags = (card.getAttribute("data-tags") || "").split(",");
					var title = card.getAttribute("data-title") || "";
					var desc = card.getAttribute("data-desc") || "";

					var matchesTag = currentFilter === "all" || tags.indexOf(currentFilter) !== -1;
					var matchesQuery = !q || title.indexOf(q) !== -1 || desc.indexOf(q) !== -1 || tags.some(function(t) { return t.indexOf(q) !== -1; });

					if (matchesTag && matchesQuery) {
						card.style.display = "flex";
						visibleCount++;
					} else {
						card.style.display = "none";
					}
				});

				if (clearBtn) {
					if (q) {
						clearBtn.classList.remove("hidden");
					} else {
						clearBtn.classList.add("hidden");
					}
				}

				updateCountAndEmpty(visibleCount);
			}

			function applyFilter(filter) {
				currentFilter = filter;
				filterBtns.forEach(function (btn) {
					var match = btn.getAttribute("data-filter") === filter;
					btn.setAttribute("aria-pressed", match ? "true" : "false");
					if (match) {
						btn.style.backgroundColor = "var(--token-color-primary, #22c55e)";
						btn.style.color = "var(--token-color-primary-foreground, #000000)";
						btn.style.borderColor = "var(--token-color-primary, #22c55e)";
					} else {
						btn.style.backgroundColor = "var(--token-color-surface, #0a0e0b)";
						btn.style.color = "var(--token-color-text-primary, #111827)";
						btn.style.borderColor = "var(--token-color-border, #1a291f)";
					}
				});
				updateVisibility();
			}

			var authorBanner = document.getElementById("author-filter-banner");
			var authorNameEl = document.getElementById("author-filter-name");

			function applyAuthorFilter(authorName) {
				if (!authorName) return;
				var target = authorName.toLowerCase().trim();
				if (authorBanner && authorNameEl) {
					authorBanner.classList.remove("hidden");
					authorNameEl.textContent = authorName;
				}
				filterBtns.forEach(function (btn) {
					btn.setAttribute("aria-pressed", "false");
					btn.style.backgroundColor = "var(--token-color-surface, #0a0e0b)";
					btn.style.color = "var(--token-color-text-primary, #111827)";
					btn.style.borderColor = "var(--token-color-border, #1a291f)";
				});
				var visibleCount = 0;
				cards.forEach(function (card) {
					var authors = (card.getAttribute("data-authors") || "").split("|");
					var matched = authors.some(function (a) {
						return a.indexOf(target) !== -1 || target.indexOf(a) !== -1;
					});
					if (matched) {
						card.style.display = "flex";
						visibleCount++;
					} else {
						card.style.display = "none";
					}
				});
				updateCountAndEmpty(visibleCount);
			}

			function resetAllFilters() {
				if (searchInput) searchInput.value = "";
				currentQuery = "";
				if (authorBanner) authorBanner.classList.add("hidden");
				applyFilter("all");
				var url = new URL(window.location);
				url.searchParams.delete("q");
				url.searchParams.delete("tag");
				url.searchParams.delete("author");
				window.history.replaceState({}, "", url);
			}

			var searchDebounceTimer = null;
			if (searchInput) {
				searchInput.oninput = function(e) {
					currentQuery = e.target.value;
					updateVisibility();
					var url = new URL(window.location);
					if (currentQuery.trim()) {
						url.searchParams.set("q", currentQuery.trim());
					} else {
						url.searchParams.delete("q");
					}
					window.history.replaceState({}, "", url);

					clearTimeout(searchDebounceTimer);
					var trimmedQ = currentQuery.trim();
					if (trimmedQ.length >= 2) {
						searchDebounceTimer = setTimeout(function() {
							if (typeof window.trackTelemetry === "function") {
								var matchCount = 0;
								cards.forEach(function(c) {
									if (c.style.display !== "none") matchCount++;
								});
								window.trackTelemetry("internal_search", {
									query: trimmedQ,
									result_count: matchCount
								});
							}
						}, 750);
					}
				};

				searchInput.onkeydown = function(e) {
					if (e.key === "Escape" && searchInput.value) {
						e.preventDefault();
						searchInput.value = "";
						currentQuery = "";
						updateVisibility();
						var url = new URL(window.location);
						url.searchParams.delete("q");
						window.history.replaceState({}, "", url);
					}
				};
			}

			if (clearBtn) {
				clearBtn.onclick = function() {
					if (searchInput) {
						searchInput.value = "";
						searchInput.focus();
					}
					currentQuery = "";
					updateVisibility();
					var url = new URL(window.location);
					url.searchParams.delete("q");
					window.history.replaceState({}, "", url);
				};
			}

			if (resetBtn) {
				resetBtn.onclick = resetAllFilters;
			}

			if (!window.__tkSearchShortcutBound) {
				window.__tkSearchShortcutBound = true;
				window.addEventListener("keydown", function(e) {
					var activeInput = document.getElementById("blog-search-input");
					if (!activeInput) return;
					if ((e.key === "/" && document.activeElement !== activeInput && document.activeElement.tagName !== "INPUT" && document.activeElement.tagName !== "TEXTAREA") || (e.ctrlKey && e.key === "k") || (e.metaKey && e.key === "k")) {
						e.preventDefault();
						activeInput.focus();
					}
				});
			}

			filterBtns.forEach(function (btn) {
				btn.onclick = function () {
					if (authorBanner) authorBanner.classList.add("hidden");
					var filter = btn.getAttribute("data-filter");
					applyFilter(filter);
					var url = new URL(window.location);
					url.searchParams.delete("author");
					if (filter === "all") {
						url.searchParams.delete("tag");
					} else {
						url.searchParams.set("tag", filter);
					}
					window.history.replaceState({}, "", url);
				};
			});

			var params = new URLSearchParams(window.location.search);
			var authorParam = params.get("author");
			var tagParam = params.get("tag");
			var queryParam = params.get("q");

			if (queryParam && searchInput) {
				searchInput.value = queryParam;
				currentQuery = queryParam;
			}

			if (authorParam) {
				applyAuthorFilter(authorParam);
			} else if (tagParam) {
				applyFilter(tagParam);
			} else if (queryParam) {
				updateVisibility();
			}
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", setupFilter);
		} else {
			setupFilter();
		}
		document.addEventListener("astro:page-load", setupFilter);
		document.addEventListener("astro:after-swap", setupFilter);
	})();
</script>
