---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ScrollReveal from "../../components/ScrollReveal.tsx";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { SITE } from "../../config/site.mjs";
import { Image } from "astro:assets";
import { getBlogImage } from "../../utils/blogImages";
import { getPostAuthors, formatAuthorNames } from "../../data/authors";
import ShareButtons from "../../components/ShareButtons.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import ReadingProgressBar from "../../components/ReadingProgressBar.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import BatteryRetentionCalculator from "../../components/interactive/BatteryRetentionCalculator.tsx";
import TelecomTimelineMatrix from "../../components/interactive/TelecomTimelineMatrix.tsx";
import GeodesicCompassSimulator from "../../components/interactive/GeodesicCompassSimulator.tsx";
import TpmSpireAttestationSimulator from "../../components/interactive/TpmSpireAttestationSimulator.tsx";
import ScxLatencySimulator from "../../components/interactive/ScxLatencySimulator.tsx";
import AgentSandboxSimulator from "../../components/interactive/AgentSandboxSimulator.tsx";
import PostQuantumMeshSimulator from "../../components/interactive/PostQuantumMeshSimulator.tsx";
import McpSecuritySimulator from "../../components/interactive/McpSecuritySimulator.tsx";
import ImmutableBackupSimulator from "../../components/interactive/ImmutableBackupSimulator.tsx";
import DisaggregatedInferenceSimulator from "../../components/interactive/DisaggregatedInferenceSimulator.tsx";
import ConfidentialComputingSimulator from "../../components/interactive/ConfidentialComputingSimulator.tsx";
import CxlMemoryTieringSimulator from "../../components/interactive/CxlMemoryTieringSimulator.tsx";
import November3EphemeraAlmanac from "../../components/interactive/November3EphemeraAlmanac.tsx";
import EbpfIoUringRootkitSimulator from "../../components/interactive/EbpfIoUringRootkitSimulator.tsx";
import Nvfp4MicroscalingSimulator from "../../components/interactive/Nvfp4MicroscalingSimulator.tsx";

export async function getStaticPaths() {
	const blogPosts = await getCollection("blog");
	return blogPosts.map((post) => ({
		params: { slug: post.id },
		props: { post, allPosts: blogPosts },
	}));
}

type Props = {
	post: CollectionEntry<"blog">;
	allPosts: CollectionEntry<"blog">[];
};

const { post, allPosts = [] } = Astro.props;
const { Content, headings = [] } = await render(post);
const heroImage = getBlogImage(post.data.heroImage);
// Get the dynamic OG image URL
const ogImageUrl = new URL(`/og/${post.id}.png`, import.meta.env.SITE || SITE.url).href;
const authors = getPostAuthors(post.data);
const authorNamesStr = formatAuthorNames(authors);
const postUrl = `${SITE.url}/blog/${post.id}`;

const postJsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "BreadcrumbList",
			"itemListElement": [
				{ "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
				{ "@type": "ListItem", "position": 2, "name": "Dispatches", "item": `${SITE.url}/blog` },
				...(post.data.tags && post.data.tags.length > 0 ? [{
					"@type": "ListItem",
					"position": 3,
					"name": `#${post.data.tags[0]}`,
					"item": `${SITE.url}/tags/${encodeURIComponent(post.data.tags[0])}`
				}, {
					"@type": "ListItem",
					"position": 4,
					"name": post.data.title,
					"item": postUrl
				}] : [{
					"@type": "ListItem",
					"position": 3,
					"name": post.data.title,
					"item": postUrl
				}])
			]
		},
		{
			"@type": "BlogPosting",
			"headline": post.data.title,
			"description": post.data.description,
			"image": ogImageUrl,
			"author": authors.map(a => ({
				"@type": "Person",
				"name": a.name,
				"url": a.website || `${SITE.url}/author/${a.id}`
			})),
			"publisher": {
				"@type": "Organization",
				"name": SITE.title,
				"logo": {
					"@type": "ImageObject",
					"url": `${SITE.url}/favicon.svg`
				}
			},
			"datePublished": post.data.pubDate.toISOString(),
			"dateModified": (post.data.updatedDate || post.data.pubDate).toISOString(),
			"mainEntityOfPage": {
				"@type": "WebPage",
				"@id": postUrl
			}
		}
	]
};
---

<Layout
	title={`${post.data.title} | ${SITE.title}`}
	description={post.data.description}
	canonicalURL={`${SITE.url}/blog/${post.id}`}
	jsonLd={postJsonLd}
	ogType="article"
	ogImage={ogImageUrl}
	ogImageWidth={1200}
	ogImageHeight={630}
	ogImageAlt={post.data.title}
	articlePublishedTime={post.data.pubDate.toISOString()}
	articleModifiedTime={(post.data.updatedDate || post.data.pubDate).toISOString()}
	articleAuthor={authorNamesStr}
	articleSection={post.data.tags?.[0] || "Engineering"}
	articleTags={post.data.tags || []}
	noindex={post.data.draft}
	preloadImages={heroImage ? [heroImage.src] : []}
>
	<ReadingProgressBar />
	<Header />
	<main id="main-content" role="main" class="min-h-screen">
		<div class="max-w-7xl mx-auto px-4 pt-6 flex items-start gap-10">
			<article class="flex-1 min-w-0 max-w-4xl mx-auto">
				<ScrollReveal client:load>
					<!-- Semantic Breadcrumbs for Navigation & SEO -->
					<nav aria-label="Breadcrumb" class="mb-6 font-mono text-xs">
						<ol class="inline-flex items-center gap-1.5 flex-wrap" style="color: var(--token-color-text-muted, #94a3b8);">
							<li class="inline-flex items-center">
								<a href="/" class="hover:text-[var(--token-color-primary)] transition-colors">Home</a>
							</li>
							<li class="opacity-40">/</li>
							<li class="inline-flex items-center">
								<a href="/blog" class="hover:text-[var(--token-color-primary)] transition-colors">Dispatches</a>
							</li>
							{post.data.tags && post.data.tags.length > 0 && (
								<>
									<li class="opacity-40">/</li>
									<li class="inline-flex items-center">
										<a
											href={`/tags/${encodeURIComponent(post.data.tags[0])}`}
											class="hover:text-[var(--token-color-primary)] transition-colors uppercase font-semibold text-[11px]"
											style="color: var(--token-color-primary, #22EE44);"
										>
											#{post.data.tags[0]}
										</a>
									</li>
								</>
							)}
							<li class="opacity-40">/</li>
							<li class="inline-flex items-center font-medium truncate max-w-[240px] sm:max-w-md" aria-current="page" style="color: var(--token-color-text-primary, #f8fafc);">
								{post.data.title}
							</li>
						</ol>
					</nav>
				</ScrollReveal>
			{
				heroImage && (
					<div class="w-full mb-4 mt-4 px-4">
						<Image
							src={heroImage}
							alt={post.data.title}
							transition:name={`blog-image-${post.id}`}
							class="w-full h-96 md:h-[500px] object-cover rounded-lg"
							style="border-radius: 0.5rem;"
							loading="eager"
							fetchpriority="high"
							widths={[400, 800, 1200, 1600]}
							sizes="(max-width: 768px) 100vw, 1200px"
						/>
					</div>
				)
			}
			<div class="px-4 pt-8 pb-16">
				{
					post.data.draft && (
						<div class="mb-6 p-4 rounded-xl border border-amber-500/60 bg-amber-500/10 text-amber-300 font-mono text-xs flex flex-wrap items-center justify-between gap-3 shadow-lg">
							<div class="flex items-center gap-2.5">
								<span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse" />
								<span>
									<strong>DRAFT TELEMETRY:</strong> This dispatch is unlisted
									and pending final review.
								</span>
							</div>
							<span class="px-2 py-0.5 rounded text-[10px] uppercase font-bold border border-amber-500/40 bg-amber-500/20">
								DRAFT
							</span>
						</div>
					)
				}
				<header class="mb-8">
					<ScrollReveal client:load delay={0.2}>
						<h1
							class="text-4xl md:text-5xl font-bold mb-4"
							style="color: var(--token-color-text-primary, #111827);"
						>
							{post.data.title}
						</h1>
					</ScrollReveal>
					<ScrollReveal client:load delay={0.3}>
						<div
							class="flex flex-wrap items-center gap-4 text-sm mb-6"
							style="color: var(--token-color-text-muted, #374151);"
						>
							<time datetime={post.data.pubDate.toISOString()}>
								Published{" "}
								{
									post.data.pubDate.toLocaleDateString("en-US", {
										year: "numeric",
										month: "long",
										day: "numeric",
									})
								}
							</time>
							{
								post.data.updatedDate && (
									<time datetime={post.data.updatedDate.toISOString()}>
										Updated{" "}
										{post.data.updatedDate.toLocaleDateString("en-US", {
											year: "numeric",
											month: "long",
											day: "numeric",
										})}
									</time>
								)
							}
							{
								authors.length > 0 && (
									<span class="inline-flex items-center gap-1.5 flex-wrap">
										<span>by</span>
										{authors.map((author, i) => (
											<span class="inline-flex items-center gap-1 font-medium">
												<a
													href={`/author/${author.id}`}
													class="hover:underline transition-colors font-mono text-xs sm:text-sm"
													style="color: var(--token-color-primary, #22EE44);"
												>
													{author.name}
												</a>
												{i < authors.length - 2 ? (
													<span>,</span>
												) : i === authors.length - 2 ? (
													<span class="opacity-75">&amp;</span>
												) : null}
											</span>
										))}
									</span>
								)
							}
						</div>
					</ScrollReveal>
					{
						post.data.tags && post.data.tags.length > 0 && (
							<ScrollReveal client:load delay={0.4}>
								<div class="flex flex-wrap gap-2 mb-6">
									{post.data.tags.map((tag) => (
										<a
											href={`/tags/${encodeURIComponent(tag)}`}
											class="px-3 py-1 rounded-full text-xs font-mono font-medium border transition-all hover:scale-105"
											style="background-color: var(--token-color-surface, #0f172a); border-color: var(--token-color-border, #334155); color: var(--token-color-primary, #22EE44);"
										>
											#{tag}
										</a>
									))}
								</div>
							</ScrollReveal>
						)
					}
				</header>

				<ScrollReveal client:load delay={0.5}>
					<div class="prose prose-lg max-w-none">
						<Content />
					</div>
				</ScrollReveal>

				{post.id === "announcing-sparetank-intelligent-battery-longevity-emergency-guard" && (
					<ScrollReveal client:load delay={0.6}>
						<div class="mt-12 p-6 sm:p-8 rounded-2xl border bg-black/60 shadow-2xl" style="border-color: rgba(34, 197, 94, 0.3);">
							<div class="flex items-center gap-2 mb-2 font-mono text-xs text-green-400 uppercase tracking-widest">
								<span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
								<span>// TACTICAL SIMULATION // CELL RETENTION LAB</span>
							</div>
							<h3 class="text-xl sm:text-2xl font-bold font-mono text-white mb-2">
								Interactive Electrochemical Retention Simulator
							</h3>
							<p class="text-xs font-mono text-gray-400 mb-6">
								Adjust target charge thresholds to observe projected 3-year capacity retention and cycle lifespan multipliers in real time.
							</p>
							<BatteryRetentionCalculator client:visible />
						</div>
					</ScrollReveal>
				)}

				{post.id === "announcing-silent-mode-control-granular-android-call-screening" && (
					<ScrollReveal client:load delay={0.6}>
						<div class="mt-12 p-6 sm:p-8 rounded-2xl border bg-black/60 shadow-2xl" style="border-color: rgba(168, 85, 247, 0.3);">
							<div class="flex items-center gap-2 mb-2 font-mono text-xs text-purple-400 uppercase tracking-widest">
								<span class="w-2 h-2 rounded-full bg-purple-500 animate-pulse"></span>
								<span>// TACTICAL SIMULATION // TELECOM PROTOCOL MATRIX</span>
							</div>
							<h3 class="text-xl sm:text-2xl font-bold font-mono text-white mb-2">
								Interactive 24-Hour Call Firewall Simulator
							</h3>
							<p class="text-xs font-mono text-gray-400 mb-6">
								Simulate inbound telecom calls across scheduled time windows to observe automatic quiet hours, repeat caller bypasses, and contact screening.
							</p>
							<TelecomTimelineMatrix client:visible />
						</div>
					</ScrollReveal>
				)}

				{post.id === "coordy-zero-backend-geodesic-vector-plotting-url-hash-compression" && (
					<ScrollReveal client:load delay={0.6}>
						<div class="mt-12 p-6 sm:p-8 rounded-2xl border bg-black/60 shadow-2xl" style="border-color: rgba(6, 182, 212, 0.3);">
							<div class="flex items-center gap-2 mb-2 font-mono text-xs text-cyan-400 uppercase tracking-widest">
								<span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
								<span>// TACTICAL SIMULATION // GEODESIC &amp; WMM2025 LAB</span>
							</div>
							<h3 class="text-xl sm:text-2xl font-bold font-mono text-white mb-2">
								Interactive Geodesic Orthodrome vs. Rhumb Loxodrome &amp; WMM2025 Simulator
							</h3>
							<p class="text-xs font-mono text-gray-400 mb-6">
								Compare initial forward azimuth, meridian convergence drift, constant-heading Rhumb distance penalties, and WMM2025 magnetic declination across global coordinates in real time.
							</p>
							<GeodesicCompassSimulator client:visible />
						</div>
					</ScrollReveal>
				)}

				{post.id === "secret-zero-bare-metal-kubernetes-tpm2-spiffe-spire-openbao" && (
					<ScrollReveal client:load delay={0.6}>
						<div class="mt-12 p-6 sm:p-8 rounded-2xl border bg-black/60 shadow-2xl" style="border-color: rgba(34, 238, 68, 0.3);">
							<div class="flex items-center gap-2 mb-2 font-mono text-xs text-emerald-400 uppercase tracking-widest">
								<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
								<span>// TACTICAL SIMULATION // SILICON ROOT OF TRUST LAB</span>
							</div>
							<h3 class="text-xl sm:text-2xl font-bold font-mono text-white mb-2">
								Interactive TPM 2.0 + SPIFFE/SPIRE + OpenBao Attestation Simulator
							</h3>
							<p class="text-xs font-mono text-gray-400 mb-6">
								Simulate Evil Maid boot tampering, NVMe drive theft, and rogue container image substitution to observe how TPM 2.0 PCR quotes and SPIRE workload selectors halt unauthorized credential issuance.
							</p>
							<TpmSpireAttestationSimulator client:visible />
						</div>
					</ScrollReveal>
				)}

				{post.id === "custom-linux-kernel-scheduling-userspace-sched-ext-rust" && (
					<ScrollReveal client:load delay={0.6}>
						<div class="mt-12 p-6 sm:p-8 rounded-2xl border bg-black/60 shadow-2xl" style="border-color: rgba(34, 238, 68, 0.3);">
							<div class="flex items-center gap-2 mb-2 font-mono text-xs text-emerald-400 uppercase tracking-widest">
								<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
								<span>// TACTICAL SIMULATION // KERNEL SCHED_EXT DSQ LAB</span>
							</div>
							<h3 class="text-xl sm:text-2xl font-bold font-mono text-white mb-2">
								Interactive sched_ext (scx) Tail-Latency &amp; Watchdog Simulator
							</h3>
							<p class="text-xs font-mono text-gray-400 mb-6">
								Hot-swap between Linux EEVDF, scx_bpfland, scx_lavd, and custom Rustland schedulers under variable all-core build saturation, tune DSQ time slices, and inject BPF watchdog stalls in real time.
							</p>
							<ScxLatencySimulator client:visible />
						</div>
					</ScrollReveal>
				)}

				{post.id === "sandboxing-autonomous-coding-agents-firecracker-landlock-ebpf" && (
					<ScrollReveal client:load delay={0.6}>
						<div class="mt-12 p-6 sm:p-8 rounded-2xl border bg-black/60 shadow-2xl" style="border-color: rgba(6, 182, 212, 0.3);">
							<div class="flex items-center gap-2 mb-2 font-mono text-xs text-cyan-400 uppercase tracking-widest">
								<span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
								<span>// TACTICAL SIMULATION // THREE-RING AGENT CONTAINMENT LAB</span>
							</div>
							<h3 class="text-xl sm:text-2xl font-bold font-mono text-white mb-2">
								Interactive Autonomous Agent Breakout &amp; Containment Simulator
							</h3>
							<p class="text-xs font-mono text-gray-400 mb-6">
								Simulate cloud IMDS token theft, shared-kernel io_uring privilege escalation, host filesystem credential leaks, and public PyPI exfiltration across Docker, Rootless Seccomp, gVisor, and the Three-Ring Firecracker+Landlock+eBPF jail.
							</p>
							<AgentSandboxSimulator client:visible />
						</div>
					</ScrollReveal>
				)}

				{post.id === "post-quantum-wireguard-hybrid-ml-kem-rosenpass-mesh" && (
					<ScrollReveal client:load delay={0.6}>
						<div class="mt-12 p-6 sm:p-8 rounded-2xl border bg-black/60 shadow-2xl" style="border-color: rgba(34, 238, 68, 0.3);">
							<div class="flex items-center gap-2 mb-2 font-mono text-xs text-emerald-400 uppercase tracking-widest">
								<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
								<span>// TACTICAL SIMULATION // HYBRID POST-QUANTUM MESH LAB</span>
							</div>
							<h3 class="text-xl sm:text-2xl font-bold font-mono text-white mb-2">
								Interactive Harvest-Now-Decrypt-Later (HNDL) &amp; Rosenpass Dual-KEM Simulator
							</h3>
							<p class="text-xs font-mono text-gray-400 mb-6">
								Compare Classical WireGuard, Static PSK, Single-KEM Lattice, and Rosenpass Dual-KEM (Classic McEliece 460896 + ML-KEM-512) under active CRQC Shor attacks, future disk compromises, and variable PSK rotation intervals.
							</p>
							<PostQuantumMeshSimulator client:visible />
						</div>
					</ScrollReveal>
				)}

				{post.id === "mcp-under-siege-tool-poisoning-securing-model-context-protocol" && (
					<ScrollReveal client:load delay={0.6}>
						<div class="mt-12 p-6 sm:p-8 rounded-2xl border bg-black/60 shadow-2xl" style="border-color: rgba(6, 182, 212, 0.3);">
							<div class="flex items-center gap-2 mb-2 font-mono text-xs text-cyan-400 uppercase tracking-widest">
								<span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
								<span>// TACTICAL SIMULATION // ZERO-TRUST MCP INTERCEPTOR LAB</span>
							</div>
							<h3 class="text-xl sm:text-2xl font-bold font-mono text-white mb-2">
								Interactive MCP Tool-Poisoning, Rug-Pull &amp; Taint-Tracking Simulator
							</h3>
							<p class="text-xs font-mono text-gray-400 mb-6">
								Compare what the human operator sees in the IDE UI against the raw JSON-RPC payload injected into the LLM system prompt, and test RFC 8785 JCS lockfiles, Unicode tag strippers, and capability taint gates.
							</p>
							<McpSecuritySimulator client:visible />
						</div>
					</ScrollReveal>
				)}

				{post.id === "immutable-backups-s3-object-lock-seaweedfs-kopia-restic" && (
					<ScrollReveal client:load delay={0.6}>
						<div class="mt-12 p-6 sm:p-8 rounded-2xl border bg-black/60 shadow-2xl" style="border-color: rgba(34, 238, 68, 0.3);">
							<div class="flex items-center gap-2 mb-2 font-mono text-xs text-emerald-400 uppercase tracking-widest">
								<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
								<span>// TACTICAL SIMULATION // WORM OBJECT LOCK SURVIVABILITY LAB</span>
							</div>
							<h3 class="text-xl sm:text-2xl font-bold font-mono text-white mb-2">
								Interactive S3 Object Lock Substrate &amp; Ransomware Survivability Simulator
							</h3>
							<p class="text-xs font-mono text-gray-400 mb-6">
								Test compromised backup clients, SeaweedFS Filer/DeleteBucket side-doors, NTP clock fast-forward attacks, and storage root breaches across self-hosted and dual-substrate B2/Wasabi/AWS WORM architectures.
							</p>
							<ImmutableBackupSimulator client:visible />
						</div>
					</ScrollReveal>
				)}

				{post.id === "disaggregated-llm-serving-prefill-decode-rdma-rocev2" && (
					<ScrollReveal client:load delay={0.6}>
						<div class="mt-12 p-6 sm:p-8 rounded-2xl border bg-black/60 shadow-2xl" style="border-color: rgba(6, 182, 212, 0.3);">
							<div class="flex items-center gap-2 mb-2 font-mono text-xs text-cyan-400 uppercase tracking-widest">
								<span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
								<span>// TACTICAL SIMULATION // DISAGGREGATED RDMA KV-STREAMING LAB</span>
							</div>
							<h3 class="text-xl sm:text-2xl font-bold font-mono text-white mb-2">
								Interactive Prefill-Decode RDMA KV-Transfer &amp; Tail-Latency Simulator
							</h3>
							<p class="text-xs font-mono text-gray-400 mb-6">
								Model KV-cache payload sizes across GQA (Llama-3.3-70B, Qwen-2.5-72B, Llama-3.1-405B) and MLA (DeepSeek-V3 671B), compare FP8 vs. BF16 precision over 100G–800G RoCEv2/IB fabrics, and observe layer-pipelined overlap and p99 ITL stalls.
							</p>
							<DisaggregatedInferenceSimulator client:visible />
						</div>
					</ScrollReveal>
				)}

				{post.id === "confidential-computing-amd-sev-snp-intel-tdx-nvidia-h100-cc-attestation" && (
					<ScrollReveal client:load delay={0.6}>
						<div class="mt-12 p-6 sm:p-8 rounded-2xl border bg-black/60 shadow-2xl" style="border-color: rgba(34, 238, 68, 0.3);">
							<div class="flex items-center gap-2 mb-2 font-mono text-xs text-emerald-400 uppercase tracking-widest">
								<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
								<span>// TACTICAL SIMULATION // CONFIDENTIAL SILICON ENCLAVE LAB</span>
							</div>
							<h3 class="text-xl sm:text-2xl font-bold font-mono text-white mb-2">
