---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ScrollReveal from '../../components/ScrollReveal.tsx';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { SITE } from '../../config/site.mjs';
import { Image } from 'astro:assets';
import { getBlogImage } from '../../utils/blogImages';
import { getPostAuthors, formatAuthorNames } from '../../data/authors';

export async function getStaticPaths() {
	const blogPosts = await getCollection('blog');
	return blogPosts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

type Props = {
	post: CollectionEntry<'blog'>;
};

const { post } = Astro.props;
const { Content } = await render(post);
const heroImage = getBlogImage(post.data.heroImage);
// Get the image URL for ogImage meta tag
const ogImageUrl = heroImage ? new URL(heroImage.src, import.meta.env.SITE || SITE.url).href : undefined;
const authors = getPostAuthors(post.data);
const authorNamesStr = formatAuthorNames(authors);
---

<Layout
	title={`${post.data.title} | ${SITE.title}`}
	description={post.data.description}
	canonicalURL={`${SITE.url}/blog/${post.id}`}
	ogType="article"
	ogImage={ogImageUrl}
>
	<Header />
	<main id="main-content" role="main" class="min-h-screen">
		<article class="max-w-4xl mx-auto">
			<ScrollReveal client:load>
				<div class="px-4 pt-8">
				<a
					href="/blog"
					class="inline-flex items-center gap-2 transition-colors mb-4"
					style="color: var(--token-color-text-muted, #374151);"
					onmouseenter={(e) => e.currentTarget.style.color = 'var(--token-color-text-primary, #111827)'}
					onmouseleave={(e) => e.currentTarget.style.color = 'var(--token-color-text-muted, #374151)'}
				>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="w-5 h-5"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="m12 19-7-7 7-7" />
							<path d="M19 12H5" />
						</svg>
						<span>Back to Blog</span>
					</a>
				</div>
			</ScrollReveal>
			{heroImage && (
				<div class="w-full mb-4 mt-4 px-4">
					<Image
						src={heroImage}
						alt={post.data.title}
						transition:name={`blog-image-${post.id}`}
						class="w-full h-96 md:h-[500px] object-cover rounded-lg"
						style="border-radius: 0.5rem;"
						loading="eager"
						widths={[400, 800, 1200, 1600]}
						sizes="(max-width: 768px) 100vw, 1200px"
					/>
				</div>
			)}
			<div class="px-4 pt-8 pb-16">
				<header class="mb-8">
					<ScrollReveal client:load delay={0.2}>
						<h1 class="text-4xl md:text-5xl font-bold mb-4" style="color: var(--token-color-text-primary, #111827);">
							{post.data.title}
						</h1>
					</ScrollReveal>
					<ScrollReveal client:load delay={0.3}>
						<div class="flex flex-wrap items-center gap-4 text-sm mb-6" style="color: var(--token-color-text-muted, #374151);">
							<time datetime={post.data.pubDate.toISOString()}>
								Published{' '}
								{post.data.pubDate.toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'long',
									day: 'numeric',
								})}
							</time>
							{post.data.updatedDate && (
								<time datetime={post.data.updatedDate.toISOString()}>
									Updated{' '}
									{post.data.updatedDate.toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'long',
										day: 'numeric',
									})}
								</time>
							)}
							{authors.length > 0 && (
								<span class="inline-flex items-center gap-1.5 flex-wrap">
									<span>by</span>
									{authors.map((author, i) => (
										<span class="inline-flex items-center gap-1 font-medium">
											<a
												href={`/blog?author=${encodeURIComponent(author.name)}`}
												class="hover:underline transition-colors font-mono text-xs sm:text-sm"
												style="color: var(--token-color-primary, #22EE44);"
											>
												{author.name}
											</a>
											{i < authors.length - 2 ? <span>,</span> : i === authors.length - 2 ? <span class="opacity-75">&amp;</span> : null}
										</span>
									))}
								</span>
							)}
						</div>
					</ScrollReveal>
					{post.data.tags && post.data.tags.length > 0 && (
						<ScrollReveal client:load delay={0.4}>
							<div class="flex flex-wrap gap-2 mb-6">
								{post.data.tags.map((tag) => (
								<span
									class="px-3 py-1 rounded-full text-sm"
									style="background-color: var(--token-color-surface, #f9fafb); color: var(--token-color-text-primary, #111827);"
								>
										{tag}
									</span>
								))}
							</div>
						</ScrollReveal>
					)}
				</header>

				<ScrollReveal client:load delay={0.5}>
					<div class="prose prose-lg max-w-none">
						<Content />
					</div>
				</ScrollReveal>

				<!-- Co-Authors & Contributors Section -->
				<section class="mt-14 pt-8 border-t" style="border-color: var(--token-color-border, #334155);">
					<h3 class="text-xs font-mono uppercase tracking-wider mb-6 flex items-center gap-2" style="color: var(--token-color-primary, #22EE44);">
						<span class="w-1.5 h-1.5 rounded-full inline-block animate-pulse" style="background-color: var(--token-color-primary, #22EE44);"></span>
						<span>{authors.length > 1 ? '// CO-AUTHORS & CONTRIBUTORS' : '// ABOUT THE AUTHOR'}</span>
					</h3>
					<div class="grid grid-cols-1 gap-4">
						{authors.map((author) => (
							<div
								class="p-6 rounded-xl border flex flex-col sm:flex-row items-start sm:items-center gap-5 transition-all"
								style="background-color: var(--token-color-surface, #0e0a12); border-color: var(--token-color-border, #1f2937);"
							>
								<div
									class="w-14 h-14 rounded-xl flex items-center justify-center font-mono font-bold text-xl shrink-0 shadow-sm"
									style="background-color: var(--token-color-primary, #22c55e); color: var(--token-color-primary-foreground, #000000);"
								>
									{author.initials || 'JC'}
								</div>
								<div class="flex-1 min-w-0">
									<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-1">
										<h4 class="text-lg font-bold font-mono" style="color: var(--token-color-text-primary, #111827);">
											<a href={`/blog?author=${encodeURIComponent(author.name)}`} class="hover:underline">
												{author.name}
											</a>
										</h4>
										{author.role && (
											<span class="text-xs font-mono px-2 py-0.5 rounded border self-start sm:self-auto" style="background-color: var(--token-color-background, #000000); border-color: var(--token-color-border, #334155); color: var(--token-color-primary, #22c55e);">
												{author.role}
											</span>
										)}
									</div>
									{author.bio && (
										<p class="text-sm leading-relaxed mb-3" style="color: var(--token-color-text-muted, #94a3b8);">
											{author.bio}
										</p>
									)}
									<div class="flex items-center gap-3 text-xs font-mono">
										{author.github && (
											<a
												href={author.github}
												target="_blank"
												rel="noopener noreferrer"
												class="inline-flex items-center gap-1 hover:underline"
												style="color: var(--token-color-primary, #22c55e);"
											>
												<span>github ↗</span>
											</a>
										)}
										{author.website && (
											<a
												href={author.website}
												target="_blank"
												rel="noopener noreferrer"
												class="inline-flex items-center gap-1 hover:underline"
												style="color: var(--token-color-text-muted, #94a3b8);"
											>
												<span>website ↗</span>
											</a>
										)}
										<a
											href={`/blog?author=${encodeURIComponent(author.name)}`}
											class="inline-flex items-center gap-1 hover:underline ml-auto"
											style="color: var(--token-color-text-muted, #94a3b8);"
										>
											<span>View all dispatches →</span>
										</a>
									</div>
								</div>
							</div>
						))}
					</div>
				</section>

				<!-- Schema.org JSON-LD Article structured data with multiple Person authors -->
				<script type="application/ld+json" set:html={JSON.stringify({
					"@context": "https://schema.org",
					"@type": "BlogPosting",
					"headline": post.data.title,
					"description": post.data.description,
					"datePublished": post.data.pubDate.toISOString(),
					"dateModified": (post.data.updatedDate || post.data.pubDate).toISOString(),
					"author": authors.map((a) => ({
						"@type": "Person",
						"name": a.name,
						...(a.website ? { "url": a.website } : {}),
						...(a.role ? { "jobTitle": a.role } : {})
					})),
					...(ogImageUrl ? { "image": ogImageUrl } : {})
				})} />

				<footer class="mt-12 pt-8 border-t" style="border-color: var(--token-color-border, #e5e7eb);">
					<a
						href="/blog"
						class="transition-colors inline-flex items-center gap-2"
						style="color: var(--token-color-text-muted, #374151);"
						onmouseenter={(e) => e.currentTarget.style.color = 'var(--token-color-text-primary, #111827)'}
						onmouseleave={(e) => e.currentTarget.style.color = 'var(--token-color-text-muted, #374151)'}
					>
						← Back to Blog
					</a>
				</footer>
			</div>
		</article>
	</main>
	<Footer />
</Layout>

<style>
	/* Critical CSS: Ensure border-radius is applied immediately to prevent FOUC */
	article > div img,
	article > div[data-astro-cid] img,
	article > div > img {
		border-radius: 0.5rem;
	}
</style>
