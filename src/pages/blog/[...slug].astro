<!-- Cyberpunk Terminal Code Block Decorator & 1-Click Copy Script -->
<script is:inline>
	(function () {
		function decorateCodeBlocks() {
			var pres = document.querySelectorAll("article pre");
			pres.forEach(function (pre) {
				if (pre.getAttribute("data-decorated")) return;
				pre.setAttribute("data-decorated", "true");

				// Create wrapper
				var wrapper = document.createElement("div");
				wrapper.className = "terminal-code-wrapper my-6 rounded-xl border border-white/10 bg-black/90 shadow-2xl overflow-hidden";

				// Create header
				var header = document.createElement("div");
				header.className = "flex items-center justify-between px-4 py-2 border-b border-white/10 bg-[#0a0f18] text-xs font-mono select-none";

				// Left controls [● ● ●]
				var controls = document.createElement("div");
				controls.className = "flex items-center gap-2";
				controls.innerHTML = `
					<span class="flex gap-1.5">
						<span class="w-2.5 h-2.5 rounded-full bg-red-500/80 inline-block"></span>
						<span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80 inline-block"></span>
						<span class="w-2.5 h-2.5 rounded-full bg-green-500/80 inline-block"></span>
					</span>
					<span class="text-[10px] text-gray-500 ml-2">// TERMINAL CONSOLE //</span>
				`;

				// Right copy button
				var copyBtn = document.createElement("button");
				copyBtn.className = "px-2.5 py-1 rounded text-[11px] font-mono text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 transition-all flex items-center gap-1.5 cursor-pointer";
				copyBtn.innerHTML = `<span>COPY</span><span>⧉</span>`;

				var hasCopiedCode = false;
				var hasDeepRead = false;
				var hasFiredHighIntent = false;

				function checkHighIntent() {
					if (hasCopiedCode && hasDeepRead && !hasFiredHighIntent) {
						hasFiredHighIntent = true;
						if (typeof window.trackTelemetry === "function") {
							window.trackTelemetry("high_intent_engineer", {
								article_id: window.location.pathname.replace(/^\/blog\//, "").replace(/\/$/, ""),
								trigger: "code_copy_plus_90pct_depth",
								value: 10.0,
								currency: "USD"
							});
						}
					}
				}

				copyBtn.onclick = function () {
					var codeText = pre.innerText || pre.textContent || "";
					navigator.clipboard.writeText(codeText).then(function () {
						copyBtn.innerHTML = `<span class="text-[#22EE44] font-bold">COPIED // 0x00</span><span>✓</span>`;
						copyBtn.style.borderColor = "#22EE44";

						hasCopiedCode = true;
						if (typeof window.trackTelemetry === "function") {
							var codeEl = pre.querySelector("code");
							var langClass = codeEl ? codeEl.className : "";
							window.trackTelemetry("code_copy", {
								article_id: window.location.pathname.replace(/^\/blog\//, "").replace(/\/$/, ""),
								code_length: codeText.length,
								language: langClass.replace("language-", "").trim() || "text",
								value: 2.5,
								currency: "USD"
							});
						}
						checkHighIntent();

						setTimeout(function () {
							copyBtn.innerHTML = `<span>COPY</span><span>⧉</span>`;
							copyBtn.style.borderColor = "";
						}, 2000);
					});
				};

				header.appendChild(controls);
				header.appendChild(copyBtn);

				// Re-parent pre inside wrapper
				pre.parentNode.insertBefore(wrapper, pre);
				wrapper.appendChild(header);
				wrapper.appendChild(pre);
				pre.style.margin = "0";
				pre.style.borderRadius = "0";
			});
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", decorateCodeBlocks);
		} else {
			decorateCodeBlocks();
		}
		document.addEventListener("astro:page-load", decorateCodeBlocks);

		// Article Scroll Depth Milestone Telemetry
		var trackedMilestones = new Set();
		function checkScrollDepth() {
			var article = document.querySelector("article");
			if (!article) return;
			var rect = article.getBoundingClientRect();
			var totalHeight = article.offsetHeight;
			var visibleTop = window.scrollY || window.pageYOffset;
			var articleTop = article.offsetTop;
			var progress = Math.min(100, Math.max(0, Math.round(((visibleTop - articleTop + window.innerHeight * 0.5) / totalHeight) * 100)));

			[25, 50, 75, 90].forEach(function (threshold) {
				if (progress >= threshold && !trackedMilestones.has(threshold)) {
					trackedMilestones.add(threshold);
					if (typeof window.trackTelemetry === "function") {
						window.trackTelemetry("scroll_milestone", {
							depth: threshold,
							article_id: window.location.pathname.replace(/^\/blog\//, "").replace(/\/$/, ""),
							value: threshold === 90 ? 1.0 : undefined,
							currency: threshold === 90 ? "USD" : undefined
						});
					}
					if (threshold === 90 && typeof checkHighIntent === "function") {
						hasDeepRead = true;
						checkHighIntent();
					}
				}
			});
		}

		window.addEventListener("scroll", checkScrollDepth, { passive: true });
		document.addEventListener("astro:page-load", function () {
			trackedMilestones.clear();
		});
	})();
</script>

