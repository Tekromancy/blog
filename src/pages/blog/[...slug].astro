---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ScrollReveal from "../../components/ScrollReveal.tsx";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { SITE } from "../../config/site.mjs";
import { Image } from "astro:assets";
import { getBlogImage } from "../../utils/blogImages";
import { getPostAuthors, formatAuthorNames } from "../../data/authors";
import ShareButtons from "../../components/ShareButtons.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import ReadingProgressBar from "../../components/ReadingProgressBar.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import BatteryRetentionCalculator from "../../components/interactive/BatteryRetentionCalculator.tsx";
import TelecomTimelineMatrix from "../../components/interactive/TelecomTimelineMatrix.tsx";

export async function getStaticPaths() {
	const blogPosts = await getCollection("blog");
	return blogPosts.map((post) => ({
		params: { slug: post.id },
		props: { post, allPosts: blogPosts },
	}));
}

type Props = {
	post: CollectionEntry<"blog">;
	allPosts: CollectionEntry<"blog">[];
};

const { post, allPosts = [] } = Astro.props;
const { Content, headings = [] } = await render(post);
const heroImage = getBlogImage(post.data.heroImage);
// Get the image URL for ogImage meta tag
const ogImageUrl = heroImage
	? new URL(heroImage.src, import.meta.env.SITE || SITE.url).href
	: undefined;
const authors = getPostAuthors(post.data);
const authorNamesStr = formatAuthorNames(authors);
const postUrl = `${SITE.url}/blog/${post.id}`;
---

<Layout
	title={`${post.data.title} | ${SITE.title}`}
	description={post.data.description}
	canonicalURL={`${SITE.url}/blog/${post.id}`}
	ogType="article"
	ogImage={ogImageUrl}
	noindex={post.data.draft}
>
	<ReadingProgressBar />
	<Header />
	<main id="main-content" role="main" class="min-h-screen">
		<div class="max-w-7xl mx-auto px-4 pt-8 flex items-start gap-10">
			<article class="flex-1 min-w-0 max-w-4xl mx-auto">
				<ScrollReveal client:load>
					<div class="mb-4">
					<a
						href="/blog"
						class="inline-flex items-center gap-2 transition-colors mb-4"
						style="color: var(--token-color-text-muted, #374151);"
						onmouseenter={(e) =>
							(e.currentTarget.style.color =
								"var(--token-color-text-primary, #111827)")}
						onmouseleave={(e) =>
							(e.currentTarget.style.color =
								"var(--token-color-text-muted, #374151)")}
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="w-5 h-5"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="m12 19-7-7 7-7"></path>
							<path d="M19 12H5"></path>
						</svg>
						<span>Back to Blog</span>
					</a>
				</div>
			</ScrollReveal>
			{
				heroImage && (
					<div class="w-full mb-4 mt-4 px-4">
						<Image
							src={heroImage}
							alt={post.data.title}
							transition:name={`blog-image-${post.id}`}
							class="w-full h-96 md:h-[500px] object-cover rounded-lg"
							style="border-radius: 0.5rem;"
							loading="eager"
							widths={[400, 800, 1200, 1600]}
							sizes="(max-width: 768px) 100vw, 1200px"
						/>
					</div>
				)
			}
			<div class="px-4 pt-8 pb-16">
				{
					post.data.draft && (
						<div class="mb-6 p-4 rounded-xl border border-amber-500/60 bg-amber-500/10 text-amber-300 font-mono text-xs flex flex-wrap items-center justify-between gap-3 shadow-lg">
							<div class="flex items-center gap-2.5">
								<span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse" />
								<span>
									<strong>DRAFT TELEMETRY:</strong> This dispatch is unlisted
									and pending final review.
								</span>
							</div>
							<span class="px-2 py-0.5 rounded text-[10px] uppercase font-bold border border-amber-500/40 bg-amber-500/20">
								DRAFT
							</span>
						</div>
					)
				}
				<header class="mb-8">
					<ScrollReveal client:load delay={0.2}>
						<h1
							class="text-4xl md:text-5xl font-bold mb-4"
							style="color: var(--token-color-text-primary, #111827);"
						>
							{post.data.title}
						</h1>
					</ScrollReveal>
					<ScrollReveal client:load delay={0.3}>
						<div
							class="flex flex-wrap items-center gap-4 text-sm mb-6"
							style="color: var(--token-color-text-muted, #374151);"
						>
							<time datetime={post.data.pubDate.toISOString()}>
								Published{" "}
								{
									post.data.pubDate.toLocaleDateString("en-US", {
										year: "numeric",
										month: "long",
										day: "numeric",
									})
								}
							</time>
							{
								post.data.updatedDate && (
									<time datetime={post.data.updatedDate.toISOString()}>
										Updated{" "}
										{post.data.updatedDate.toLocaleDateString("en-US", {
											year: "numeric",
											month: "long",
											day: "numeric",
										})}
									</time>
								)
							}
							{
								authors.length > 0 && (
									<span class="inline-flex items-center gap-1.5 flex-wrap">
										<span>by</span>
										{authors.map((author, i) => (
											<span class="inline-flex items-center gap-1 font-medium">
												<a
													href={`/blog?author=${encodeURIComponent(author.name)}`}
													class="hover:underline transition-colors font-mono text-xs sm:text-sm"
													style="color: var(--token-color-primary, #22EE44);"
												>
													{author.name}
												</a>
												{i < authors.length - 2 ? (
													<span>,</span>
												) : i === authors.length - 2 ? (
													<span class="opacity-75">&amp;</span>
												) : null}
											</span>
										))}
									</span>
								)
							}
						</div>
					</ScrollReveal>
					{
						post.data.tags && post.data.tags.length > 0 && (
							<ScrollReveal client:load delay={0.4}>
								<div class="flex flex-wrap gap-2 mb-6">
									{post.data.tags.map((tag) => (
										<span
											class="px-3 py-1 rounded-full text-sm"
											style="background-color: var(--token-color-surface, #f9fafb); color: var(--token-color-text-primary, #111827);"
										>
											{tag}
										</span>
									))}
								</div>
							</ScrollReveal>
						)
					}
				</header>

				<ScrollReveal client:load delay={0.5}>
					<div class="prose prose-lg max-w-none">
						<Content />
					</div>
				</ScrollReveal>

				{post.id === "announcing-sparetank-intelligent-battery-longevity-emergency-guard" && (
					<ScrollReveal client:load delay={0.6}>
						<div class="mt-12 p-6 sm:p-8 rounded-2xl border bg-black/60 shadow-2xl" style="border-color: rgba(34, 197, 94, 0.3);">
							<div class="flex items-center gap-2 mb-2 font-mono text-xs text-green-400 uppercase tracking-widest">
								<span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
								<span>// TACTICAL SIMULATION // CELL RETENTION LAB</span>
							</div>
							<h3 class="text-xl sm:text-2xl font-bold font-mono text-white mb-2">
								Interactive Electrochemical Retention Simulator
							</h3>
							<p class="text-xs font-mono text-gray-400 mb-6">
								Adjust target charge thresholds to observe projected 3-year capacity retention and cycle lifespan multipliers in real time.
							</p>
							<BatteryRetentionCalculator client:visible />
						</div>
					</ScrollReveal>
				)}

				{post.id === "announcing-silent-mode-control-granular-android-call-screening" && (
					<ScrollReveal client:load delay={0.6}>
						<div class="mt-12 p-6 sm:p-8 rounded-2xl border bg-black/60 shadow-2xl" style="border-color: rgba(168, 85, 247, 0.3);">
							<div class="flex items-center gap-2 mb-2 font-mono text-xs text-purple-400 uppercase tracking-widest">
								<span class="w-2 h-2 rounded-full bg-purple-500 animate-pulse"></span>
								<span>// TACTICAL SIMULATION // TELECOM PROTOCOL MATRIX</span>
							</div>
							<h3 class="text-xl sm:text-2xl font-bold font-mono text-white mb-2">
								Interactive 24-Hour Call Firewall Simulator
							</h3>
							<p class="text-xs font-mono text-gray-400 mb-6">
								Simulate inbound telecom calls across scheduled time windows to observe automatic quiet hours, repeat caller bypasses, and contact screening.
							</p>
							<TelecomTimelineMatrix client:visible />
						</div>
					</ScrollReveal>
				)}

				<!-- Co-Authors & Contributors Section -->
				<section
					class="mt-14 pt-8 border-t"
					style="border-color: var(--token-color-border, #334155);"
				>
					<h3
						class="text-xs font-mono uppercase tracking-wider mb-6 flex items-center gap-2"
						style="color: var(--token-color-primary, #22EE44);"
					>
						<span
							class="w-1.5 h-1.5 rounded-full inline-block animate-pulse"
							style="background-color: var(--token-color-primary, #22EE44);"
						></span>
						<span
							>{
								authors.length > 1
									? "// CO-AUTHORS & CONTRIBUTORS"
									: "// ABOUT THE AUTHOR"
							}</span
						>
					</h3>
					<div class="grid grid-cols-1 gap-4">
						{
							authors.map((author) => (
								<div
									class="p-6 rounded-xl border flex flex-col sm:flex-row items-start sm:items-center gap-5 transition-all"
									style="background-color: var(--token-color-surface, #0e0a12); border-color: var(--token-color-border, #1f2937);"
								>
									<div
										class="w-14 h-14 rounded-xl flex items-center justify-center font-mono font-bold text-xl shrink-0 shadow-sm"
										style="background-color: var(--token-color-primary, #22c55e); color: var(--token-color-primary-foreground, #000000);"
									>
										{author.initials || "JC"}
									</div>
									<div class="flex-1 min-w-0">
										<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-1">
											<h4
												class="text-lg font-bold font-mono"
												style="color: var(--token-color-text-primary, #111827);"
											>
												<a
													href={`/blog?author=${encodeURIComponent(author.name)}`}
													class="hover:underline"
												>
													{author.name}
												</a>
											</h4>
											{author.role && (
												<span
													class="text-xs font-mono px-2 py-0.5 rounded border self-start sm:self-auto"
													style="background-color: var(--token-color-background, #000000); border-color: var(--token-color-border, #334155); color: var(--token-color-primary, #22c55e);"
												>
													{author.role}
												</span>
											)}
										</div>
										{author.bio && (
											<p
												class="text-sm leading-relaxed mb-3"
												style="color: var(--token-color-text-muted, #94a3b8);"
											>
												{author.bio}
											</p>
										)}
										<div class="flex items-center gap-3 text-xs font-mono">
											{author.github && (
												<a
													href={author.github}
													target="_blank"
													rel="noopener noreferrer"
													class="inline-flex items-center gap-1 hover:underline"
													style="color: var(--token-color-primary, #22c55e);"
												>
													<span>github ↗</span>
												</a>
											)}
											{author.website && (
												<a
													href={author.website}
													target="_blank"
													rel="noopener noreferrer"
													class="inline-flex items-center gap-1 hover:underline"
													style="color: var(--token-color-text-muted, #94a3b8);"
												>
													<span>website ↗</span>
												</a>
											)}
											<a
												href={`/blog?author=${encodeURIComponent(author.name)}`}
												class="inline-flex items-center gap-1 hover:underline ml-auto"
												style="color: var(--token-color-text-muted, #94a3b8);"
											>
												<span>View all dispatches →</span>
											</a>
										</div>
									</div>
								</div>
							))
						}
					</div>
				</section>

				<!-- Share & Syndicate Dispatch -->
				<ShareButtons
					title={post.data.title}
					url={postUrl}
					description={post.data.description}
				/>

				<!-- Related Field Dispatches -->
				<RelatedPosts currentPost={post} allPosts={allPosts} />

				<!-- Schema.org JSON-LD Article structured data with multiple Person authors -->
				<script
					type="application/ld+json"
					set:html={JSON.stringify({
						"@context": "https://schema.org",
						"@type": "BlogPosting",
						headline: post.data.title,
						description: post.data.description,
						datePublished: post.data.pubDate.toISOString(),
						dateModified: (
							post.data.updatedDate || post.data.pubDate
						).toISOString(),
						author: authors.map((a) => ({
							"@type": "Person",
							name: a.name,
							...(a.website ? { url: a.website } : {}),
							...(a.role ? { jobTitle: a.role } : {}),
						})),
						...(ogImageUrl ? { image: ogImageUrl } : {}),
					})}
				/>

				<footer
					class="mt-12 pt-8 border-t"
					style="border-color: var(--token-color-border, #e5e7eb);"
				>
					<a
						href="/blog"
						class="transition-colors inline-flex items-center gap-2"
						style="color: var(--token-color-text-muted, #374151);"
						onmouseenter={(e) =>
							(e.currentTarget.style.color =
								"var(--token-color-text-primary, #111827)")}
						onmouseleave={(e) =>
							(e.currentTarget.style.color =
								"var(--token-color-text-muted, #374151)")}
					>
						← Back to Blog
					</a>
				</footer>
			</div>
		</article>

		<!-- Right-Rail Floating Table of Contents -->
		<TableOfContents headings={headings} />
	</div>
</main>
<Footer />
</Layout>

<!-- Cyberpunk Terminal Code Block Decorator & 1-Click Copy Script -->
<script is:inline>
	(function () {
		function decorateCodeBlocks() {
			var pres = document.querySelectorAll("article pre");
			pres.forEach(function (pre) {
				if (pre.getAttribute("data-decorated")) return;
				pre.setAttribute("data-decorated", "true");

				// Create wrapper
				var wrapper = document.createElement("div");
				wrapper.className = "terminal-code-wrapper my-6 rounded-xl border border-white/10 bg-black/90 shadow-2xl overflow-hidden";

				// Create header
				var header = document.createElement("div");
				header.className = "flex items-center justify-between px-4 py-2 border-b border-white/10 bg-[#0a0f18] text-xs font-mono select-none";

				// Left controls [● ● ●]
				var controls = document.createElement("div");
				controls.className = "flex items-center gap-2";
				controls.innerHTML = `
					<span class="flex gap-1.5">
						<span class="w-2.5 h-2.5 rounded-full bg-red-500/80 inline-block"></span>
						<span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80 inline-block"></span>
						<span class="w-2.5 h-2.5 rounded-full bg-green-500/80 inline-block"></span>
					</span>
					<span class="text-[10px] text-gray-500 ml-2">// TERMINAL CONSOLE //</span>
				`;

				// Right copy button
				var copyBtn = document.createElement("button");
				copyBtn.className = "px-2.5 py-1 rounded text-[11px] font-mono text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 transition-all flex items-center gap-1.5 cursor-pointer";
				copyBtn.innerHTML = `<span>COPY</span><span>⧉</span>`;

				copyBtn.onclick = function () {
					var codeText = pre.innerText || pre.textContent || "";
					navigator.clipboard.writeText(codeText).then(function () {
						copyBtn.innerHTML = `<span class="text-[#22EE44] font-bold">COPIED // 0x00</span><span>✓</span>`;
						copyBtn.style.borderColor = "#22EE44";
						setTimeout(function () {
							copyBtn.innerHTML = `<span>COPY</span><span>⧉</span>`;
							copyBtn.style.borderColor = "";
						}, 2000);
					});
				};

				header.appendChild(controls);
				header.appendChild(copyBtn);

				// Re-parent pre inside wrapper
				pre.parentNode.insertBefore(wrapper, pre);
				wrapper.appendChild(header);
				wrapper.appendChild(pre);
				pre.style.margin = "0";
				pre.style.borderRadius = "0";
			});
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", decorateCodeBlocks);
		} else {
			decorateCodeBlocks();
		}
		document.addEventListener("astro:page-load", decorateCodeBlocks);
	})();
</script>

<style>
	/* Critical CSS: Ensure border-radius is applied immediately to prevent FOUC */
	article > div img,
	article > div[data-astro-cid] img,
	article > div > img {
		border-radius: 0.5rem;
	}
</style>
