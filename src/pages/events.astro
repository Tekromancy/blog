---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import { Icon } from "astro-icon/components";
import { SITE } from "../config/site.mjs";
import { CYBER_EVENTS } from "../data/events";

const events = CYBER_EVENTS;
---

<Layout
  title={`Field Operations & Upcoming Events | ${SITE.title}`}
  description="Upcoming community events, Capture The Flag (CTF) wargames, adversarial security briefings, and technical meetups in Austin, TX and beyond."
  canonicalURL={`${SITE.url}/events`}
>
  <Header />
  <main id="main-content" role="main" class="min-h-screen" style="background-color: var(--token-color-background, #000000);">
    <div class="max-w-6xl mx-auto px-4 py-16 md:py-20">
      <!-- Section Header -->
      <header class="text-center mb-16">
        <ScrollReveal client:load>
          <h1 class="text-4xl md:text-6xl font-extrabold font-mono tracking-tight mb-4 text-balance" style="color: var(--token-color-text-primary, #111827);">
            Field Operations &amp; Events
          </h1>
        </ScrollReveal>
        <ScrollReveal client:load delay={0.15}>
          <p class="text-lg md:text-xl max-w-2xl mx-auto leading-relaxed tk-copy-secondary">
            In-person combat wargames, 3D technical briefings, and security community meetups in Austin, Texas and across the digital ether.
          </p>
        </ScrollReveal>
      </header>

      <!-- Events List Container -->
      <div class="space-y-10">
        {events.map((event, index) => (
          <ScrollReveal client:load delay={0.1 * (index + 1)}>
            <article class="tk-plate p-6 md:p-10 relative overflow-hidden">
              <!-- Top Badges & Meta -->
              <div class="relative z-10 flex flex-wrap items-center justify-between gap-3 mb-6">
                <div class="flex flex-wrap items-center gap-2.5">
                  <span
                    class="px-3 py-1 rounded text-xs font-mono font-bold tracking-wider uppercase"
                    style="background-color: var(--token-color-primary, #22c55e); color: var(--token-color-primary-foreground, #000000);"
                  >
                    {event.typeLabel}
                  </span>
                  <span
                    class="px-3 py-1 rounded text-xs font-mono font-semibold border flex items-center gap-1.5"
                    style="background-color: var(--token-color-background, #000000); border-color: var(--token-color-border, #1a291f); color: var(--token-color-primary, #22c55e);"
                  >
                    <span class="w-2 h-2 rounded-full animate-pulse" style="background-color: var(--token-color-primary, #22c55e);"></span>
                    {event.statusLabel}
                  </span>
                </div>
                <div
                  class="flex items-center gap-2 text-xs font-mono px-3.5 py-1.5 rounded border tk-copy-meta"
                  style="background-color: var(--token-color-background, #000000); border-color: var(--token-color-border, #1a291f);"
                >
                  <Icon name="tabler:map-pin" class="w-4 h-4 shrink-0" style="color: var(--token-color-primary, #22c55e);" aria-hidden="true" />
                  <span class="font-medium">{event.location}</span>
                </div>
              </div>

              <!-- Title & Association -->
              <div class="relative z-10 mb-4">
                <h2 class="text-2xl md:text-4xl font-extrabold font-mono mb-2.5 tracking-tight text-balance" style="color: var(--token-color-text-primary, #111827);">
                  {event.title}
                </h2>
                {event.venue && (
                  <div class="inline-flex items-center gap-1.5 text-sm font-mono mb-2 tk-copy-meta">
                    <Icon name="tabler:building-community" class="w-4 h-4 shrink-0" style="color: var(--token-color-primary, #22c55e);" aria-hidden="true" />
                    <span>Venue:</span>
                    <span class="font-semibold" style="color: var(--token-color-text-primary, #111827);">{event.venue}</span>
                  </div>
                )}
                <div class="flex flex-wrap items-center gap-1.5 text-xs md:text-sm font-mono tk-copy-meta">
                  <span>In association with</span>
                  <a
                    href={event.orgUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="tk-focus-ring font-bold underline decoration-dotted transition-opacity hover:opacity-80"
                    style="color: var(--token-color-primary, #22c55e);"
                  >
                    {event.organization} ({event.displayOrgUrl || 'aicyberalliance.org'}) ↗
                  </a>
                </div>
              </div>

              <!-- Description -->
              <p class="relative z-10 text-base leading-relaxed mb-6 max-w-4xl tk-copy-secondary">
                {event.description}
              </p>

              <!-- Operational Tracks / Highlights (1px Hairline Decomposition — No Nested Card) -->
              {event.highlights && event.highlights.length > 0 && (
                <div class="relative z-10 mb-6 pt-5 border-t" style="border-color: var(--token-color-border, #1a291f);">
                  <div class="text-xs font-mono font-semibold uppercase tracking-wider mb-3" style="color: var(--token-color-primary, #22c55e);">
                    Tactical Tracks &amp; Challenge Vectors
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs md:text-sm font-mono tk-copy-secondary">
                    {event.highlights.map((h) => (
                      <div class="flex items-start gap-2">
                        <Icon name="tabler:chevron-right" class="w-4 h-4 shrink-0 mt-0.5" style="color: var(--token-color-primary, #22c55e);" aria-hidden="true" />
                        <span>{h}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              <!-- Tags & CTAs Footer -->
              <div class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-6 border-t" style="border-color: var(--token-color-border, #1a291f);">
                <div class="flex flex-wrap gap-2">
                  {event.tags.map((t) => (
                    <span class="text-xs font-mono px-2.5 py-1 rounded-full border tk-copy-meta" style="background-color: var(--token-color-background, #000000); border-color: var(--token-color-border, #1a291f);">
                      #{t}
                    </span>
                  ))}
                </div>
                <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
                  {event.secondaryCta && (
                    <a
                      href={event.secondaryCta.url}
                      class="tk-btn-secondary !py-2.5 !px-4 !text-xs"
                    >
                      <span>{event.secondaryCta.label}</span>
                    </a>
                  )}
                  <a
                    href={event.primaryCta.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="tk-btn-primary !py-2.5 !px-5 !text-xs"
                  >
                    <span>{event.primaryCta.label}</span>
                    <Icon name="tabler:arrow-up-right" class="w-3.5 h-3.5" aria-hidden="true" />
                  </a>
                </div>
              </div>
            </article>
          </ScrollReveal>
        ))}
      </div>

      <!-- Alliance Callout Banner -->
      <section class="tk-plate mt-16 p-8 sm:p-10 text-center">
        <h3 class="text-xl sm:text-2xl font-bold font-mono mb-3" style="color: var(--token-color-text-primary, #111827);">
          Host a Wargame or Propose a Briefing?
        </h3>
        <p class="text-sm sm:text-base max-w-xl mx-auto mb-6 leading-relaxed tk-copy-secondary">
          The Tekromancy guild partners with community alliances, academic institutions, and defense researchers to host live CTFs and adversarial simulations.
        </p>
        <div class="flex flex-wrap justify-center gap-3.5">
          <a href="/contact" class="tk-btn-primary !text-xs">
            <Icon name="tabler:terminal" class="w-4 h-4" aria-hidden="true" />
            <span>Transmit Intel / Propose Talk</span>
          </a>
          <a
            href="https://aicyberalliance.org"
            target="_blank"
            rel="noopener noreferrer"
            class="tk-btn-secondary !text-xs"
          >
            <span>AI Cyber Alliance Portal</span>
            <Icon name="tabler:arrow-up-right" class="w-3.5 h-3.5" aria-hidden="true" />
          </a>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
