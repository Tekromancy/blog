---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import { SITE } from "../config/site.mjs";
import { CYBER_EVENTS } from "../data/events";

const events = CYBER_EVENTS;
---

<Layout
  title={`Field Operations & Upcoming Events | ${SITE.title}`}
  description="Upcoming community events, Capture The Flag (CTF) wargames, adversarial security briefings, and technical meetups in Austin, TX and beyond."
  canonicalURL={`${SITE.url}/events`}
>
  <Header />
  <main id="main-content" role="main" class="min-h-screen" style="background-color: var(--token-color-background, #000000);">
    <div class="max-w-6xl mx-auto px-4 py-16 md:py-24">
      <!-- Section Header -->
      <header class="text-center mb-16">
        <ScrollReveal client:load>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono mb-4 border" style="background-color: var(--token-color-surface, #1e293b); border-color: var(--token-color-border, #334155); color: var(--token-color-primary, #22EE44);">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75" style="background-color: var(--token-color-primary, #22EE44);"></span>
              <span class="relative inline-flex rounded-full h-2 w-2" style="background-color: var(--token-color-primary, #22EE44);"></span>
            </span>
            <span style="color: var(--token-color-primary, #22EE44);">TACTICAL RADAR // FIELD OPERATIONS</span>
          </div>
          <h1 class="text-4xl md:text-6xl font-extrabold font-mono tracking-tight mb-4" style="color: var(--token-color-text-primary, #f8fafc);">
            Field Operations &amp; Events
          </h1>
        </ScrollReveal>
        <ScrollReveal client:load delay={0.2}>
          <p class="text-lg md:text-xl max-w-2xl mx-auto leading-relaxed" style="color: var(--token-color-text-muted, #94a3b8);">
            In-person combat wargames, 3D technical briefings, and security community meetups in Austin, Texas and across the digital ether.
          </p>
        </ScrollReveal>
      </header>

      <!-- Events List Container -->
      <div class="space-y-10">
        {events.map((event, index) => (
          <ScrollReveal client:load delay={0.1 * (index + 1)}>
            <article
              class="relative rounded-2xl border p-6 md:p-10 overflow-hidden transition-all duration-300 hover:shadow-2xl"
              style="background-color: var(--token-color-surface, #0f172a); border-color: var(--token-color-border, #334155);"
            >
              <!-- Ambient Glow -->
              <div
                class="absolute top-0 right-0 w-96 h-96 opacity-10 pointer-events-none rounded-full blur-3xl"
                style="background-color: var(--token-color-primary, #22EE44);"
                aria-hidden="true"
              ></div>

              <!-- Top Badges & Meta -->
              <div class="relative z-10 flex flex-wrap items-center justify-between gap-3 mb-6">
                <div class="flex flex-wrap items-center gap-2.5">
                  <span
                    class="px-3 py-1 rounded text-xs font-mono font-bold tracking-wider uppercase border"
                    style="background-color: var(--token-color-primary, #22EE44); color: var(--token-color-primary-foreground, #000000); border-color: var(--token-color-primary, #22EE44);"
                  >
                    {event.typeLabel}
                  </span>
                  <span
                    class="px-3 py-1 rounded text-xs font-mono font-semibold border flex items-center gap-1.5"
                    style="background-color: var(--token-color-surface-elevated, rgba(255,255,255,0.05)); border-color: var(--token-color-border, #334155); color: var(--token-color-primary, #22EE44);"
                  >
                    <span class="w-2 h-2 rounded-full animate-pulse" style="background-color: var(--token-color-primary, #22EE44);"></span>
                    {event.statusLabel}
                  </span>
                </div>
                <div
                  class="flex items-center gap-2 text-xs font-mono px-3.5 py-1.5 rounded border"
                  style="background-color: var(--token-color-surface-elevated, rgba(255,255,255,0.03)); border-color: var(--token-color-border, #334155); color: var(--token-color-text-muted, #94a3b8);"
                >
                  <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--token-color-primary, #22EE44);">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <span class="font-medium">{event.location}</span>
                </div>
              </div>

              <!-- Title & Association -->
              <div class="relative z-10 mb-4">
                <h2 class="text-2xl md:text-4xl font-extrabold font-mono mb-2.5 tracking-tight" style="color: var(--token-color-text-primary, #f8fafc);">
                  {event.title}
                </h2>
                {event.venue && (
                  <div class="text-sm font-mono mb-2" style="color: var(--token-color-text-muted, #94a3b8);">
                    <span class="opacity-75">📍 Venue: </span>
                    <span class="font-semibold text-[var(--token-color-text-primary)]">{event.venue}</span>
                  </div>
                )}
                <div class="flex flex-wrap items-center gap-1.5 text-xs md:text-sm font-mono" style="color: var(--token-color-text-muted, #94a3b8);">
                  <span>In association with</span>
                  <a
                    href={event.orgUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-bold underline decoration-dotted transition-opacity hover:opacity-80"
                    style="color: var(--token-color-primary, #22EE44);"
                  >
                    {event.organization} ({event.displayOrgUrl || 'aicyberalliance.org'}) ↗
                  </a>
                </div>
              </div>

              <!-- Description -->
              <p class="relative z-10 text-base leading-relaxed mb-6 max-w-4xl" style="color: var(--token-color-text-muted, #cbd5e1);">
                {event.description}
              </p>

              <!-- Operational Tracks / Highlights -->
              {event.highlights && event.highlights.length > 0 && (
                <div class="relative z-10 mb-6 p-5 rounded-xl border" style="background-color: var(--token-color-background, #020617); border-color: var(--token-color-border, #334155);">
                  <div class="text-xs font-mono font-semibold uppercase tracking-wider mb-3 flex items-center gap-2" style="color: var(--token-color-primary, #22EE44);">
                    <span>// Tactical Tracks &amp; Challenge Vectors</span>
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs md:text-sm font-mono" style="color: var(--token-color-text-primary, #f1f5f9);">
                    {event.highlights.map((h) => (
                      <div class="flex items-start gap-2.5">
                        <span class="font-bold shrink-0" style="color: var(--token-color-primary, #22EE44);">[+]</span>
                        <span>{h}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              <!-- Tags & CTAs Footer -->
              <div class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-6 border-t" style="border-color: var(--token-color-border, #334155);">
                <div class="flex flex-wrap gap-2">
                  {event.tags.map((t) => (
                    <span class="text-xs font-mono px-2.5 py-1 rounded border" style="background-color: var(--token-color-surface-elevated, rgba(255,255,255,0.03)); border-color: var(--token-color-border, #334155); color: var(--token-color-text-muted, #94a3b8);">
                      #{t}
                    </span>
                  ))}
                </div>
                <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
                  {event.secondaryCta && (
                    <a
                      href={event.secondaryCta.url}
                      class="px-4 py-2.5 rounded-lg font-mono text-xs font-semibold border transition-all hover:scale-[1.02] flex items-center gap-1.5"
                      style="background-color: var(--token-color-surface-elevated, rgba(255,255,255,0.04)); border-color: var(--token-color-border, #334155); color: var(--token-color-text-primary, #f8fafc);"
                    >
                      <span>{event.secondaryCta.label}</span>
                    </a>
                  )}
                  <a
                    href={event.primaryCta.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-5 py-2.5 rounded-lg font-mono text-xs font-bold transition-all shadow-lg hover:scale-[1.02] flex items-center gap-1.5"
                    style="background-color: var(--token-color-primary, #22EE44); color: var(--token-color-primary-foreground, #000000);"
                  >
                    <span>{event.primaryCta.label}</span>
                  </a>
                </div>
              </div>
            </article>
          </ScrollReveal>
        ))}
      </div>

      <!-- Alliance Callout Banner -->
      <section class="mt-16 p-8 rounded-2xl border text-center font-mono" style="background-color: var(--token-color-surface, #0e0a12); border-color: var(--token-color-border, #334155);">
        <h3 class="text-xl font-bold mb-3" style="color: var(--token-color-text-primary, #f8fafc);">
          Host a Wargame or Propose a Briefing?
        </h3>
        <p class="text-sm max-w-xl mx-auto mb-6 leading-relaxed" style="color: var(--token-color-text-muted, #94a3b8);">
          The Tekromancy guild partners with community alliances, academic institutions, and defense researchers to host live CTFs and adversarial simulations.
        </p>
        <div class="flex justify-center gap-4">
          <a
            href="/contact"
            class="px-5 py-2.5 rounded-lg text-xs font-bold transition-all hover:scale-105 border"
            style="background-color: var(--token-color-primary, #22EE44); color: var(--token-color-primary-foreground, #000000); border-color: var(--token-color-primary, #22EE44);"
          >
            Transmit Intel / Propose Talk →
          </a>
          <a
            href="https://aicyberalliance.org"
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-lg text-xs font-semibold border transition-all hover:scale-105"
            style="border-color: var(--token-color-border, #334155); color: var(--token-color-text-primary, #f8fafc);"
          >
            AI Cyber Alliance Portal ↗
          </a>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
