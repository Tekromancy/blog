---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import { Icon } from "astro-icon/components";
import { SITE } from "../config/site.mjs";
---

<Layout
  title={`404: Signal Lost // Page Not Found | ${SITE.title}`}
  description="The requested memory address or transmission packet could not be resolved on the Tekromancy network."
  noindex={true}
  nofollow={true}
>
  <script is:inline>
    var path = window.location.pathname;
    if (path.startsWith('/incantations/')) {
      window.location.replace('https://incantations.tekromancy.com' + path.replace(/^\/incantations/, ''));
    } else if (path === '/incantations' || path === '/incantations/') {
      window.location.replace('https://incantations.tekromancy.com/');
    }
  </script>
  <Header />

  <main
    id="main-content"
    role="main"
    class="min-h-[75vh] flex items-center justify-center px-4 py-16"
    style="background-color: var(--token-color-background, #000000);"
  >
    <div class="max-w-3xl w-full mx-auto text-center">
      <ScrollReveal client:load>
        <h1
          class="text-6xl sm:text-8xl font-extrabold font-mono tracking-tight mb-3 tk-tabular"
          style="color: var(--token-color-text-primary, #111827);"
        >
          404
        </h1>

        <p
          class="text-base sm:text-xl font-bold font-mono mb-4"
          style="color: var(--token-color-error, #ef4444);"
        >
          CODE 0x404 // TRANSMISSION PACKET DROPPED
        </p>

        <p class="text-base sm:text-lg max-w-xl mx-auto mb-8 leading-relaxed tk-copy-secondary">
          The memory address you queried does not exist on this cluster or was redacted during memory compaction. Reconnect via grep or an active relay below.
        </p>
      </ScrollReveal>

      <!-- CLI Search Form -->
      <ScrollReveal client:load delay={0.15}>
        <div class="max-w-lg mx-auto mb-12">
          <form action="/blog" method="GET" class="tk-cli-well">
            <span
              class="font-mono text-xs select-none font-bold shrink-0"
              style="color: var(--token-color-primary, #22c55e);"
            >
              grep -R:
            </span>
            <input
              type="text"
              name="q"
              placeholder="Search kernel, ebpf, kubernetes..."
              class="tk-cli-input"
              aria-label="Search dispatches"
            />
            <button
              type="submit"
              class="tk-focus-ring font-mono text-xs font-bold px-2.5 py-1 rounded border cursor-pointer shrink-0"
              style="background-color: var(--token-color-primary, #22c55e); color: var(--token-color-primary-foreground, #000000); border-color: transparent;"
            >
              RUN
            </button>
          </form>
        </div>
      </ScrollReveal>

      <!-- Recommended High-Intent Relay Points -->
      <ScrollReveal client:load delay={0.25}>
        <div
          class="border-t pt-8 max-w-xl mx-auto"
          style="border-color: var(--token-color-border, #1a291f);"
        >
          <h2 class="font-mono text-xs font-bold uppercase tracking-wider mb-4 tk-copy-meta">
            Recommended Telemetry Relays
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-left">
            <a
              href="/blog/bare-metal-kubernetes-talos-cilium-rook-ceph"
              class="tk-card p-3.5 no-underline group"
            >
              <div
                class="font-mono text-xs font-bold group-hover:text-[var(--token-color-primary)] transition-colors truncate"
                style="color: var(--token-color-text-primary, #111827);"
              >
                Bare-Metal Kubernetes
              </div>
              <div class="font-mono text-[11px] truncate tk-copy-meta">
                Talos Linux, Cilium, Rook-Ceph
              </div>
            </a>

            <a
              href="/blog/bpftrace-linux-kernel-performance-cheatsheet"
              class="tk-card p-3.5 no-underline group"
            >
              <div
                class="font-mono text-xs font-bold group-hover:text-[var(--token-color-primary)] transition-colors truncate"
                style="color: var(--token-color-text-primary, #111827);"
              >
                bpftrace Cheat Sheet
              </div>
              <div class="font-mono text-[11px] truncate tk-copy-meta">
                Real-time Linux kernel tracing
              </div>
            </a>

            <a
              href="/blog/ebpf-xdp-ddos-mitigation-line-rate-packet-filtering"
              class="tk-card p-3.5 no-underline group"
            >
              <div
                class="font-mono text-xs font-bold group-hover:text-[var(--token-color-primary)] transition-colors truncate"
                style="color: var(--token-color-text-primary, #111827);"
              >
                eBPF XDP DDoS Defense
              </div>
              <div class="font-mono text-[11px] truncate tk-copy-meta">
                100GbE line-rate packet drops
              </div>
            </a>

            <a href="/apps" class="tk-card p-3.5 no-underline group">
              <div
                class="font-mono text-xs font-bold group-hover:text-[var(--token-color-primary)] transition-colors truncate"
                style="color: var(--token-color-text-primary, #111827);"
              >
                Sovereign Android Apps
              </div>
              <div class="font-mono text-[11px] truncate tk-copy-meta">
                SpareTank &amp; Silent Mode Control
              </div>
            </a>
          </div>

          <div class="mt-8">
            <a href="/" class="tk-btn-primary">
              <span>Return to Core Mainframe</span>
              <Icon name="tabler:arrow-right" class="w-4 h-4" aria-hidden="true" />
            </a>
          </div>
        </div>
      </ScrollReveal>
    </div>
  </main>

  <Footer />
</Layout>
