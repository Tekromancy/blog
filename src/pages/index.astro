---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import { SITE } from "../config/site.mjs";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { getBlogImage } from "../utils/blogImages";
import { getPostAuthors, formatAuthorNames } from "../data/authors";

const latestPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout
  title={`${SITE.title} | ${SITE.subtitle}`}
  description={SITE.description}
  canonicalURL={SITE.url}
>
  <Header />
  <main id="main-content" role="main">
    <Hero />
    <Features />

    <!-- Recent Articles Section -->
    <section class="max-w-6xl mx-auto px-4 py-16 border-t" style="border-color: var(--token-color-border, #e5e7eb);">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-md mb-3 inline-block" style="background-color: var(--token-color-surface, #1e293b); color: var(--token-color-primary, #22EE44);">
            LATEST FIELD NOTES
          </span>
          <h2 class="text-3xl md:text-4xl font-bold font-mono tracking-tight" style="color: var(--token-color-text-primary, #111827);">
            Recent Dispatches
          </h2>
        </div>
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 font-mono text-sm font-medium transition-colors"
          style="color: var(--token-color-primary, #0ea5e9);"
        >
          <span>View all articles</span>
          <Icon name="tabler:arrow-right" class="w-4 h-4" aria-hidden="true" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {latestPosts.map((post, index) => {
          const heroImage = getBlogImage(post.data.heroImage);
          const firstTag = post.data.tags && post.data.tags.length > 0 ? post.data.tags[0] : null;
          return (
            <ScrollReveal client:load delay={0.1 * index}>
              <article
                class="rounded-xl border h-full flex flex-col justify-between transition-all hover:shadow-lg overflow-hidden group"
                style="background-color: var(--token-color-background, #ffffff); border-color: var(--token-color-border, #e5e7eb);"
              >
                <div>
                  <a href={`/blog/${post.id}`} class="block overflow-hidden relative">
                    {heroImage ? (
                      <div class="w-full h-48 overflow-hidden relative">
                        <Image
                          src={heroImage}
                          alt={post.data.title}
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                          loading="lazy"
                          widths={[400, 800]}
                          sizes="(max-width: 768px) 100vw, 33vw"
                        />
                      </div>
                    ) : (
                      <div class="w-full h-24 flex items-center justify-between px-6 border-b" style="background-color: var(--token-color-surface, #f8fafc); border-color: var(--token-color-border, #e2e8f0);">
                        <span class="font-mono text-xs opacity-75" style="color: var(--token-color-primary, #0ea5e9);">&gt;_ sys.dispatch</span>
                        <span class="font-mono text-xs" style="color: var(--token-color-text-muted, #64748b);">tekromancy.com</span>
                      </div>
                    )}
                  </a>
                  <div class="p-6">
                    <div class="flex items-center justify-between text-xs font-mono mb-2" style="color: var(--token-color-text-muted, #64748b);">
                      <time datetime={post.data.pubDate.toISOString()}>
                        {post.data.pubDate.toLocaleDateString("en-US", {
                          year: "numeric",
                          month: "short",
                          day: "numeric",
                        })}
                      </time>
                      {firstTag && (
                        <span class="px-2 py-0.5 rounded font-mono font-medium" style="background-color: var(--token-color-surface, #f1f5f9); color: var(--token-color-primary, #0ea5e9);">
                          #{firstTag}
                        </span>
                      )}
                    </div>
                    <div class="text-[11px] font-mono mb-2 flex items-center gap-1.5 truncate" style="color: var(--token-color-primary, #22EE44);">
                      <span class="opacity-70">by</span>
                      <span class="font-medium truncate">{formatAuthorNames(getPostAuthors(post.data))}</span>
                    </div>
                    <h3 class="text-lg font-bold font-mono mb-2 line-clamp-2" style="color: var(--token-color-text-primary, #111827);">
                      <a
                        href={`/blog/${post.id}`}
                        class="transition-colors hover:text-[var(--token-color-primary)]"
                      >
                        {post.data.title}
                      </a>
                    </h3>
                    <p class="text-sm line-clamp-3 mb-2" style="color: var(--token-color-text-muted, #64748b);">
                      {post.data.description}
                    </p>
                  </div>
                </div>
                <div class="px-6 pb-6 pt-0">
                  <a
                    href={`/blog/${post.id}`}
                    class="inline-flex items-center gap-1.5 text-xs font-mono font-medium transition-colors hover:translate-x-1 duration-200"
                    style="color: var(--token-color-primary, #0ea5e9);"
                  >
                    <span>Read deep-dive</span>
                    <span>→</span>
                  </a>
                </div>
              </article>
            </ScrollReveal>
          );
        })}
      </div>
    </section>

    <CTA />
  </main>
  <Footer />
</Layout>
