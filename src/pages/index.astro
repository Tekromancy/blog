---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import FeaturedApps from "../components/FeaturedApps.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import { SITE } from "../config/site.mjs";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { getBlogImage } from "../utils/blogImages";
import { getPostAuthors, formatAuthorNames } from "../data/authors";
import sketchSvg from "../assets/sketch.svg";

const latestPosts = (await getCollection("blog", ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const homeJsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${SITE.url}/#website`,
			url: SITE.url,
			name: SITE.title,
			description: SITE.description,
			publisher: {
				"@id": `${SITE.url}/#organization`,
			},
			potentialAction: {
				"@type": "SearchAction",
				target: {
					"@type": "EntryPoint",
					urlTemplate: `${SITE.url}/blog?q={search_term_string}`,
				},
				"query-input": "required name=search_term_string",
			},
		},
		{
			"@type": "Organization",
			"@id": `${SITE.url}/#organization`,
			name: SITE.title,
			url: SITE.url,
			logo: {
				"@type": "ImageObject",
				url: `${SITE.url}/ads/logo-square-1200x1200.png`,
				width: 1200,
				height: 1200,
			},
			sameAs: [SITE.github, SITE.linkedin].filter(Boolean),
		},
	],
};
---

<Layout
	title={`${SITE.title} | ${SITE.subtitle}`}
	description={SITE.description}
	canonicalURL={SITE.url}
	jsonLd={homeJsonLd}
	preloadImages={[sketchSvg.src]}
>
	<Header />
	<main id="main-content" role="main">
		<Hero />
		<Features />
		<FeaturedApps />

		<!-- Recent Articles Section -->
		<section
			class="max-w-6xl mx-auto px-4 py-20 border-t"
			style="border-color: var(--token-color-border, #1a291f);"
		>
			<div
				class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4"
			>
				<div>
					<h2
						class="text-3xl md:text-4xl font-bold font-mono tracking-tight mb-2"
						style="color: var(--token-color-text-primary, #111827);"
					>
						Recent Dispatches
					</h2>
					<p class="text-sm md:text-base tk-copy-secondary">
						Latest low-level benchmarks, kernel mechanics, and architecture blueprints.
					</p>
				</div>
				<a
					href="/blog"
					class="tk-focus-ring inline-flex items-center gap-1.5 font-mono text-sm font-semibold transition-colors hover:underline"
					style="color: var(--token-color-primary, #22c55e);"
				>
					<span>View all articles</span>
					<Icon name="tabler:arrow-right" class="w-4 h-4" aria-hidden="true" />
				</a>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				{
					latestPosts.map((post, index) => {
						const heroImage = getBlogImage(post.data.heroImage);
						const firstTag =
							post.data.tags && post.data.tags.length > 0
								? post.data.tags[0]
								: null;
						return (
							<ScrollReveal client:load delay={0.1 * index}>
								<article class="tk-card h-full flex flex-col justify-between overflow-hidden group">
									<div>
										<a
											href={`/blog/${post.id}`}
											class="block overflow-hidden relative border-b"
											style="border-color: var(--token-color-border, #1a291f);"
										>
											{heroImage ? (
												<div class="w-full aspect-video overflow-hidden relative">
													<Image
														src={heroImage}
														alt={post.data.title}
														class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
														loading="lazy"
														widths={[400, 800]}
														sizes="(max-width: 768px) 100vw, 33vw"
													/>
												</div>
											) : (
												<div
													class="w-full h-24 flex items-center justify-between px-6"
													style="background-color: var(--token-color-background, #000000);"
												>
													<span
														class="font-mono text-xs"
														style="color: var(--token-color-primary, #22c55e);"
													>
														&gt;_ sys.dispatch
													</span>
													<span class="font-mono text-xs tk-copy-meta">
														tekromancy.com
													</span>
												</div>
											)}
										</a>
										<div class="p-6">
											<div class="flex items-center justify-between text-xs font-mono mb-2 tk-copy-meta">
												<time datetime={post.data.pubDate.toISOString()}>
													{post.data.pubDate.toLocaleDateString("en-US", {
														year: "numeric",
														month: "short",
														day: "numeric",
													})}
												</time>
												{firstTag && (
													<a
														href={`/tags/${encodeURIComponent(firstTag)}`}
														class="px-2 py-0.5 rounded font-mono font-semibold hover:underline transition-colors border"
														style="background-color: var(--token-color-background, #000000); border-color: var(--token-color-border, #1a291f); color: var(--token-color-primary, #22c55e);"
													>
														#{firstTag}
													</a>
												)}
											</div>
											<div
												class="text-[11px] font-mono mb-2.5 flex flex-wrap items-center gap-1.5"
												style="color: var(--token-color-primary, #22c55e);"
											>
												<span class="tk-copy-meta">by</span>
												{getPostAuthors(post.data).map((author, i, arr) => (
													<span class="inline-flex items-center">
														<a href={`/author/${author.id}`} class="font-medium hover:underline">
															{author.name}
														</a>
														{i < arr.length - 2 ? (
															<span>, </span>
														) : i === arr.length - 2 ? (
															<span class="opacity-75 mx-1">&amp;</span>
														) : null}
													</span>
												))}
											</div>
											<h3
												class="text-lg font-bold font-mono mb-2 line-clamp-2"
												style="color: var(--token-color-text-primary, #111827);"
											>
												<a
													href={`/blog/${post.id}`}
													class="transition-colors hover:text-[var(--token-color-primary)]"
												>
													{post.data.title}
												</a>
											</h3>
											<p class="text-sm leading-relaxed line-clamp-3 mb-2 tk-copy-secondary">
												{post.data.description}
											</p>
										</div>
									</div>
									<div class="px-6 pb-6 pt-0">
										<a
											href={`/blog/${post.id}`}
											class="tk-focus-ring inline-flex items-center gap-1.5 text-xs font-mono font-semibold transition-transform group-hover:translate-x-1 duration-200"
											style="color: var(--token-color-primary, #22c55e);"
										>
											<span>Read deep-dive</span>
											<Icon name="tabler:arrow-right" class="w-3.5 h-3.5" aria-hidden="true" />
										</a>
									</div>
								</article>
							</ScrollReveal>
						);
					})
				}
			</div>
		</section>

		<CTA />
	</main>
	<Footer />
</Layout>
