---
import "../styles/global.css";
import { SITE } from "../config/site.mjs";
import type { SEOProps } from "../types/seo";
import { ClientRouter } from "astro:transitions";

interface Props extends SEOProps {
	lang?: string;
}

const {
	title = SITE.title,
	description = SITE.description,
	canonicalURL,
	ogTitle = title,
	ogDescription = description,
	ogImage = SITE.ogImage,
	ogType = "website",
	twitterCard = "summary_large_image",
	twitterTitle = ogTitle,
	twitterDescription = ogDescription,
	twitterImage = ogImage,
	twitterCreator = SITE.twitter,
	twitterSite = SITE.twitter,
	ogImageWidth = 1200,
	ogImageHeight = 630,
	ogImageAlt = title,
	articlePublishedTime,
	articleModifiedTime,
	articleAuthor,
	articleSection,
	articleTags = [],
	noindex = false,
	nofollow = false,
	lang = SITE.defaultLanguage,
	jsonLd,
} = Astro.props;

// Construct full URLs
const currentPath = Astro.url.pathname;
const canonicalPath = canonicalURL || currentPath;
const siteURL = new URL(canonicalPath, SITE.url);

// Handle image URLs - support both absolute URLs and relative paths
const getFullImageUrl = (image: string): string => {
	if (image.startsWith("http://") || image.startsWith("https://")) {
		return image;
	}
	return new URL(image, SITE.url).href;
};

const fullOgImage = getFullImageUrl(ogImage);
const fullTwitterImage = getFullImageUrl(twitterImage);

// Build robots meta content
const robotsContent = [
	noindex ? "noindex" : "index",
	nofollow ? "nofollow" : "follow",
].join(", ");
---

<!doctype html>
<html lang={lang}>
	<head>
		<!-- Google Tag Manager -->
		<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
		new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
		j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
		'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
		})(window,document,'script','dataLayer','GTM-TKGX6K5');</script>
		<!-- End Google Tag Manager -->

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${SITE.title} RSS Feed`}
			href="/rss.xml"
		/>
		<meta name="generator" content={Astro.generator} />

		<!-- Resource Hints -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="dns-prefetch" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

		<!-- Premium Theme Fonts - Loaded asynchronously to prevent render blocking -->
		<!-- Aurora Theme: Poppins (sans) + Cormorant Garamond (serif) + Fira Code (mono) -->
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Cormorant+Garamond:wght@400;500;600;700&family=Fira+Code:wght@400;500;600;700&display=swap"
			rel="stylesheet"
			media="print"
			onload="this.media='all'"
		/>
		<noscript>
			<link
				href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Cormorant+Garamond:wght@400;500;600;700&family=Fira+Code:wght@400;500;600;700&display=swap"
				rel="stylesheet"
			/>
		</noscript>
		<!-- Obsidian & Tech Fonts: Space Grotesk (sans) + IBM Plex Serif (serif) + JetBrains Mono (mono) -->
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Serif:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>

		<!-- Preload Critical Resources -->
		<link rel="preload" href="/favicon.svg" as="image" type="image/svg+xml" />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="robots" content={robotsContent} />
		<link rel="canonical" href={siteURL.href} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={siteURL.href} />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:image" content={fullOgImage} />
		<meta property="og:image:width" content={String(ogImageWidth)} />
		<meta property="og:image:height" content={String(ogImageHeight)} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:site_name" content={SITE.title} />

		<!-- Article-Specific Open Graph Tags -->
		{ogType === "article" && articlePublishedTime && (
			<meta property="article:published_time" content={articlePublishedTime} />
		)}
		{ogType === "article" && articleModifiedTime && (
			<meta property="article:modified_time" content={articleModifiedTime} />
		)}
		{ogType === "article" && articleAuthor && (
			<meta property="article:author" content={articleAuthor} />
		)}
		{ogType === "article" && articleSection && (
			<meta property="article:section" content={articleSection} />
		)}
		{ogType === "article" && articleTags.map((tag) => (
			<meta property="article:tag" content={tag} />
		))}

		<!-- Twitter -->
		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:url" content={siteURL.href} />
		<meta name="twitter:title" content={twitterTitle} />
		<meta name="twitter:description" content={twitterDescription} />
		<meta name="twitter:image" content={fullTwitterImage} />
		{twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}
		{twitterSite && <meta name="twitter:site" content={twitterSite} />}

		<!-- JSON-LD Structured Data -->
		{jsonLd && (
			<script
				type="application/ld+json"
				is:inline
				set:html={JSON.stringify(jsonLd)}
			/>
		)}

		<!-- Google Analytics (GA4) -->
		{
			SITE.googleAnalyticsId && (
				<>
					<link rel="preconnect" href="https://www.googletagmanager.com" />
					<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
					<script
						is:inline
						async
						src={`https://www.googletagmanager.com/gtag/js?id=${SITE.googleAnalyticsId}`}
					/>
					<script
						is:inline
						set:html={`
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}

					// Google Consent Mode v2 (Enables Machine Learning Conversion Modeling)
					gtag('consent', 'default', {
						'ad_storage': 'granted',
						'ad_user_data': 'granted',
						'ad_personalization': 'granted',
						'analytics_storage': 'granted',
					});

					gtag('js', new Date());
					gtag('config', '${SITE.googleAnalyticsId}', {
						send_page_view: true,
						cookie_flags: 'SameSite=None;Secure',
					});

					// Preserve Google Ads Click Identifiers across View Transitions
					(function() {
						try {
							var params = new URLSearchParams(window.location.search);
							var clickId = params.get('gclid') || params.get('gbraid') || params.get('wbraid');
							if (clickId) {
								sessionStorage.setItem('tekromancy_click_id', clickId);
							}
						} catch (e) {}
					})();

					// Enhanced Conversions Helper for Google Ads Machine Learning
					window.setEnhancedConversionData = function(data) {
						if (!data) return;
						var payload = {};
						if (data.email) payload.email = data.email.trim().toLowerCase();
						if (data.phone_number) payload.phone_number = data.phone_number.trim();
						gtag('set', 'user_data', payload);
					};

					// Global Telemetry Dispatcher for Engineering & Google Ads Smart Bidding
					window.trackTelemetry = function(eventName, params) {
						params = params || {};
						if (typeof params.value === 'number' && !params.currency) {
							params.currency = 'USD';
						}
						gtag('event', eventName, params);
						try {
							window.dispatchEvent(new CustomEvent('tekromancy:telemetry', {
								detail: { eventName: eventName, params: params, timestamp: new Date().toISOString() }
							}));
						} catch (err) {}
					};

					// SPA Navigation Sync
					document.addEventListener('astro:after-swap', () => {
						gtag('config', '${SITE.googleAnalyticsId}', {
							page_path: window.location.pathname,
							page_location: window.location.href,
							page_title: document.title,
						});
					});

					// Automated Global Telemetry Delegation with Value-Based Bidding (VBB)
					var TELEMETRY_VALUE_MAP = {
						'app_play_store_click': 50.0,
						'beta_group_click': 30.0,
						'app_portal_click': 10.0,
						'contact_intent_click': 15.0,
					};

					document.addEventListener('click', (e) => {
						const target = e.target && e.target.closest ? e.target.closest('a') : null;
						if (!target) return;

						const telemetryType = target.getAttribute('data-telemetry');
						if (telemetryType) {
							var eventValue = TELEMETRY_VALUE_MAP[telemetryType] || undefined;
							window.trackTelemetry(telemetryType, {
								app_id: target.getAttribute('data-telemetry-app') || 'unknown',
								destination: target.href,
								value: eventValue,
								currency: eventValue ? 'USD' : undefined,
							});
							return;
						}

						if (target.hostname === 'github.com') {
							window.trackTelemetry('outbound_click', {
								url: target.href,
								label: 'github_repository',
							});
						}
					});
				`}
					/>
				</>
			)
		}

		<!-- Google AdSense -->
		{
			SITE.googleAdsenseClientId && (
				<>
					<link rel="preconnect" href="https://pagead2.googlesyndication.com" />
					<link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
					<script
						is:inline
						async
						src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.googleAdsenseClientId}`}
						crossorigin="anonymous"
					/>
				</>
			)
		}

		<!-- View Transitions -->
		<ClientRouter />
	</head>
	<body
		class="min-h-screen"
		style="background-color: var(--token-color-background, #000000); color: var(--token-color-text-primary, #111827);"
	>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TKGX6K5"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->

		<script is:inline>
			/**
			 * Early Theme Initialization
			 *
			 * Architecture Decision: This script runs BEFORE page render to prevent
			 * theme flash (FOUC - Flash of Unstyled Content). We use is:inline so it
			 * executes immediately, not after Astro processes it.
			 *
			 * Why inline script:
			 * 1. Executes synchronously before page paint
			 * 2. No external dependencies
			 * 3. Works even if JavaScript is slow to load
			 * 4. Prevents visual flash when switching themes
			 */
			(function () {
				// Available color themes (light/dark are modes, not themes)
				const availableThemes = [
					"blue",
					"green",
					"purple",
					"orange",
					"aurora",
					"obsidian",
				];
				const storedTheme = localStorage.getItem("theme");
				const storedMode = localStorage.getItem("mode");

				// Set theme (default to green for terminal / matrix tech aesthetic)
				// Architecture: Validate against available themes to prevent invalid states
				const theme =
					storedTheme && availableThemes.includes(storedTheme)
						? storedTheme
						: "green";
				document.documentElement.setAttribute("data-theme", theme);

				// Set mode (default to dark for tech aesthetic, or user preference)
				// Architecture: Respects user's stored choice, defaults to dark
				let mode =
					storedMode === "light" || storedMode === "dark" ? storedMode : "dark";
				document.documentElement.setAttribute("data-mode", mode);
			})();

			/**
			 * View Transition Support
			 *
			 * Architecture Decision: Re-apply theme on Astro view transitions because:
			 * 1. View transitions don't trigger full page reload
			 * 2. Data attributes might not persist across transitions
			 * 3. Ensures theme consistency during client-side navigation
			 *
			 * This is necessary for Astro's view transitions feature.
			 */
			document.addEventListener("astro:page-load", function () {
				const storedTheme = localStorage.getItem("theme");
				const storedMode = localStorage.getItem("mode");
				if (storedTheme) {
					document.documentElement.setAttribute("data-theme", storedTheme);
				}
				if (storedMode === "light" || storedMode === "dark") {
					document.documentElement.setAttribute("data-mode", storedMode);
				}
			});

			// Also listen for after-swap to ensure theme persists
			document.addEventListener("astro:after-swap", function () {
				const storedTheme = localStorage.getItem("theme");
				const storedMode = localStorage.getItem("mode");
				if (storedTheme) {
					document.documentElement.setAttribute("data-theme", storedTheme);
				}
				if (storedMode === "light" || storedMode === "dark") {
					document.documentElement.setAttribute("data-mode", storedMode);
				}
			});
		</script>
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:rounded-lg focus:outline-none focus:ring-2 focus:ring-offset-2"
			style="background-color: var(--token-color-text-inverse, #000000); color: var(--token-color-background, #ffffff); --tw-ring-color: var(--token-color-text-inverse, #000000);"
		>
			Skip to main content
		</a>
		<slot />
	</body>
</html>
